+static void
+test_sigfm_deferred_deactivation (void)
+{
+  g_autoptr(FpDevice) dev = g_object_new (FPI_TYPE_TEST_IMG_DEV, NULL);
+  FpImageDevice *img_dev = FP_IMAGE_DEVICE (dev);
+  FpImageDevicePrivate *priv = test_img_dev_priv (img_dev);
+
+  /* A final enrollment result while the finger remains down only records the
+   * deactivation request; it must not enter the driver yet. */
+  priv->active = TRUE;
+  priv->state = FPI_IMAGE_DEVICE_STATE_AWAIT_FINGER_OFF;
+  priv->finger_present = TRUE;
+  fpi_image_device_deactivate (img_dev, FALSE);
+  g_assert_true (priv->action_pending_deactivation);
+  g_assert_cmpuint (FPI_TEST_IMG_DEV (dev)->deactivate_count, ==, 0);
+  g_assert_cmpint (priv->state, ==, FPI_IMAGE_DEVICE_STATE_AWAIT_FINGER_OFF);
+
+  /* Finger-off alone is insufficient while asynchronous SIFT is still active. */
+  priv->state = FPI_IMAGE_DEVICE_STATE_IDLE;
+  priv->finger_present = FALSE;
+  priv->minutiae_scan_active = TRUE;
+  fpi_image_device_deactivate (img_dev, FALSE);
+  g_assert_true (priv->action_pending_deactivation);
+  g_assert_cmpuint (FPI_TEST_IMG_DEV (dev)->deactivate_count, ==, 0);
+
+  /* This unit drives the private barrier state directly rather than running
+   * a full async action, so restore a quiescent state before object cleanup. */
+  priv->active = FALSE;
+  priv->state = FPI_IMAGE_DEVICE_STATE_INACTIVE;
+  priv->minutiae_scan_active = FALSE;
+}

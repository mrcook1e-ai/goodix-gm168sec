+/* SIGFM verify/identify auto-retry on no-match (NBIS & other drivers stay at 0).
+ * Note on FAR: allowing N retries (e.g. N=2 -> up to 3 touches per session)
+ * gives an impostor 3 attempts instead of 1; with GM168 SIGFM background
+ * floor <= 5 at threshold 8 (observed FAR=0), this multiplier is acceptable. */
+void
+fpi_image_device_apply_sigfm_verify_retry (FpImageDevice  *self,
+                                           FpPrint        *result,
+                                           FpPrint       **print,
+                                           GError        **error)
+{
+  FpImageDevicePrivate *priv = fp_image_device_get_instance_private (self);
+
+  g_return_if_fail (FP_IS_IMAGE_DEVICE (self));
+  g_return_if_fail (error != NULL);
+
+  if (priv->algorithm != FPI_PRINT_SIGFM)
+    return;
+
+  if (!*error && result == NULL &&
+      priv->sigfm_verify_retries > 0 &&
+      priv->verify_retry_count < priv->sigfm_verify_retries)
+    {
+      priv->verify_retry_count += 1;
+      priv->verify_retry_pending = TRUE;
+      fp_dbg ("SIGFM verify no-match: requesting retry (%d/%d)",
+              priv->verify_retry_count, priv->sigfm_verify_retries);
+      if (print)

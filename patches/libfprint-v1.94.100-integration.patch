+static void
+test_sigfm_print_equal_and_serialize (void)
+{
+  g_autoptr(FpDevice) dev = g_object_new (FPI_TYPE_TEST_IMG_DEV, NULL);
+  g_autoptr(FpImage) img1 = make_patterned_image (120, 120, FALSE, FALSE);
+  g_autoptr(FpImage) img2 = make_patterned_image (120, 120, FALSE, FALSE);
+  g_autoptr(FpPrint) p1 = NULL;
+  g_autoptr(FpPrint) p2 = NULL;
+  g_autoptr(FpPrint) p_nbis = NULL;
+  g_autoptr(FpPrint) p_undef = NULL;
+  g_autoptr(FpPrint) p_deser = NULL;
+  g_autoptr(GError) error = NULL;
+  g_autofree guchar *data = NULL;
+  gsize len = 0;
+
+  /* Modify img2 slightly so its features differ */
+  for (gint i = 0; i < 120 * 60; i++)
+    img2->data[i] = (guint8) ((img2->data[i] + 40) & 0xff);
+
+  g_assert_true (extract_sigfm_sync (img1, NULL, &error));
+  g_assert_no_error (error);
+  g_assert_true (extract_sigfm_sync (img2, NULL, &error));
+  g_assert_no_error (error);
+
+  p1 = g_object_ref_sink (fp_print_new (dev));
+  fpi_print_set_type (p1, FPI_PRINT_SIGFM);
+  fp_print_set_finger (p1, FP_FINGER_RIGHT_INDEX);
+  fp_print_set_username (p1, "sigfm_user");
+  fp_print_set_description (p1, "sigfm test");
+  g_assert_true (fpi_print_add_from_image (p1, img1, &error));
+  g_assert_no_error (error);
+
+  /* Multi-entry template via fpi_print_add_print */
+  {
+    g_autoptr(FpPrint) p_extra = g_object_ref_sink (fp_print_new (dev));
+    fpi_print_set_type (p_extra, FPI_PRINT_SIGFM);
+    g_assert_true (fpi_print_add_from_image (p_extra, img2, &error));
+    g_assert_no_error (error);
+    fpi_print_add_print (p1, p_extra);
+  }
+
+  p2 = g_object_ref_sink (fp_print_new (dev));
+  fpi_print_set_type (p2, FPI_PRINT_SIGFM);
+  g_assert_true (fpi_print_add_from_image (p2, img2, &error));
+  g_assert_no_error (error);
+  g_assert_false (fp_print_equal (p1, p2));
+
+  p_nbis = g_object_ref_sink (fp_print_new (dev));
+  fpi_print_set_type (p_nbis, FPI_PRINT_NBIS);
+  g_assert_false (fp_print_equal (p1, p_nbis));
+
+  /* Serialize & deserialize round-trip */
+  g_assert_true (fp_print_serialize (p1, &data, &len, &error));
+  g_assert_no_error (error);
+  g_assert_nonnull (data);
+  g_assert_cmpuint (len, >, 3);
+
+  p_deser = fp_print_deserialize (data, len, &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (p_deser);
+  g_assert_cmpint (fpi_print_get_type (p_deser), ==, FPI_PRINT_SIGFM);
+  g_assert_true (fp_print_equal (p1, p_deser));
+  g_assert_cmpstr (fp_print_get_username (p_deser), ==, "sigfm_user");
+  g_assert_cmpstr (fp_print_get_description (p_deser), ==, "sigfm test");
+  g_assert_cmpint (fp_print_get_finger (p_deser), ==, FP_FINGER_RIGHT_INDEX);
+
+  /* Undefined print must fail serialization cleanly */
+  p_undef = g_object_ref_sink (fp_print_new (dev));
+  {
+    g_autofree guchar *bad_data = NULL;
+    gsize bad_len = 0;
+
+    g_assert_false (fp_print_serialize (p_undef, &bad_data, &bad_len, &error));
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+    g_clear_error (&error);
+  }
+}

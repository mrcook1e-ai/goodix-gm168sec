+/* Return TRUE when the frame satisfies the driver-specific SIGFM capture
+ * policy. Coverage can be evaluated after a failed verify match so a genuine
+ * low-coverage match is never discarded. */
+gboolean
+fpi_image_device_check_sigfm_quality (FpImageDevice *self,
+                                     FpImage       *image,
+                                     gboolean       require_coverage,
+                                     GError       **error)
+{
+  FpImageDevicePrivate *priv = fp_image_device_get_instance_private (self);
+
+  g_return_val_if_fail (FP_IS_IMAGE_DEVICE (self), FALSE);
+  g_return_val_if_fail (FP_IS_IMAGE (image), FALSE);
+  g_return_val_if_fail (error == NULL || *error == NULL, FALSE);
+
+  if (priv->algorithm != FPI_PRINT_SIGFM)
+    return TRUE;

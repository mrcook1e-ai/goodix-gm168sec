+static void
+sigfm_vflip (guint8 *data, gsize width, gsize height)
+{
+  gsize data_len = width * height;
+  g_autofree guint8 *rowbuf = g_malloc (width);
+  gsize i;
+
+  for (i = 0; i < height / 2; i++)
+    {
+      gsize offset = i * width;
+      gsize swap_offset = data_len - (width * (i + 1));
+
+      memcpy (rowbuf, data + offset, width);
+      memcpy (data + offset, data + swap_offset, width);
+      memcpy (data + swap_offset, rowbuf, width);
+    }
+}
+
+static void
+sigfm_hflip (guint8 *data, gsize width, gsize height)
+{
+  g_autofree guint8 *rowbuf = g_malloc (width);
+  gsize i, j;
+
+  for (i = 0; i < height; i++)
+    {
+      gsize offset = i * width;
+
+      memcpy (rowbuf, data + offset, width);
+      for (j = 0; j < width; j++)
+        data[offset + j] = rowbuf[width - j - 1];
+    }
+}
+
+static void
+sigfm_invert_colors (guint8 *data, gsize width, gsize height)
+{
+  gsize data_len = width * height;
+  gsize i;
+
+  for (i = 0; i < data_len; i++)
+    data[i] = 0xff - data[i];
+}

+static void
+test_sigfm_match_and_nbis_compat (void)
+{
+  g_autoptr(FpiTestImgDevAutoResetClass) cls_reset = auto_reset_img_dev_class ();
+  g_autoptr(FpDevice) sigfm_dev = g_object_new (FPI_TYPE_TEST_IMG_DEV, NULL);
+  g_autoptr(FpImage) img = make_patterned_image (120, 120, FALSE, FALSE);
+  g_autoptr(FpPrint) p_sigfm = NULL;
+  g_autoptr(FpPrint) p_nbis = NULL;
+  g_autoptr(FpPrint) p_undef = NULL;
+  g_autoptr(GError) error = NULL;
+  g_autofree guchar *nbis_blob = NULL;
+  gsize nbis_len = 0;
+
+  (void) cls_reset;
+
+  g_assert_true (extract_sigfm_sync (img, NULL, &error));
+  g_assert_no_error (error);
+
+  p_sigfm = g_object_ref_sink (fp_print_new (sigfm_dev));
+  fpi_print_set_type (p_sigfm, FPI_PRINT_SIGFM);
+  g_assert_true (fpi_print_add_from_image (p_sigfm, img, &error));
+  g_assert_no_error (error);
+
+  /* Self-match at threshold 8 must succeed; absurd threshold must fail */
+  g_assert_cmpint (fpi_print_sigfm_match (p_sigfm, p_sigfm, 8, &error), ==, FPI_MATCH_SUCCESS);
+  g_assert_no_error (error);
+
+  g_assert_cmpint (fpi_print_sigfm_match (p_sigfm, p_sigfm, 100000, &error), ==, FPI_MATCH_FAIL);
+  g_assert_no_error (error);
+
+  /* Old NBIS print still serializes/deserializes cleanly, but is incompatible with SIGFM device */
+  p_nbis = g_object_ref_sink (fp_print_new (sigfm_dev));
+  fpi_print_set_type (p_nbis, FPI_PRINT_NBIS);
+  {
+    struct xyt_struct *xyt = g_new0 (struct xyt_struct, 1);
+    xyt->nrows = 1;
+    xyt->xcol[0] = 10;
+    xyt->ycol[0] = 20;
+    xyt->thetacol[0] = 30;
+    g_ptr_array_add (p_nbis->prints, xyt);
+  }
+  g_assert_true (fp_print_serialize (p_nbis, &nbis_blob, &nbis_len, &error));
+  g_assert_no_error (error);
+  {
+    g_autoptr(FpPrint) p_nbis_deser = fp_print_deserialize (nbis_blob, nbis_len, &error);
+    g_assert_no_error (error);
+    g_assert_nonnull (p_nbis_deser);
+    g_assert_true (fp_print_equal (p_nbis, p_nbis_deser));
+    g_assert_false (fp_print_compatible (p_nbis_deser, sigfm_dev));
+  }
+
+  p_undef = g_object_ref_sink (fp_print_new (sigfm_dev));
+  g_assert_true (fp_print_compatible (p_undef, sigfm_dev));
+  g_assert_true (fp_print_compatible (p_sigfm, sigfm_dev));
+
+  g_assert_cmpint (fpi_print_sigfm_match (p_nbis, p_sigfm, 8, &error), ==, FPI_MATCH_ERROR);
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_NOT_SUPPORTED);
+  g_clear_error (&error);
+
+  /* On an NBIS device, NBIS print is compatible and SIGFM print is incompatible */
+  {
+    FpImageDeviceClass *cls = FP_IMAGE_DEVICE_CLASS (g_type_class_peek_static (FPI_TYPE_TEST_IMG_DEV));
+    g_autoptr(FpDevice) nbis_dev = NULL;
+
+    cls->algorithm = FPI_PRINT_NBIS;
+    nbis_dev = g_object_new (FPI_TYPE_TEST_IMG_DEV, NULL);
+    g_assert_true (fp_print_compatible (p_nbis, nbis_dev));
+    g_assert_false (fp_print_compatible (p_sigfm, nbis_dev));
+  }
+}

+/* End-to-end ordering proof: a SIGFM match is reported as soon as the frame
+ * has been processed (REARM/wait-lift phase), before the finger is lifted
+ * and before the device is deactivated. The lifecycle afterwards (finger
+ * off -> deactivate -> identify completion) must remain intact. */
+static void
+test_sigfm_identify_match_before_finger_off (void)
+{
+  g_autoptr(FpDevice) dev = g_object_new (FPI_TYPE_TEST_IMG_DEV, NULL);
+  FpiTestImgDev *self = FPI_TEST_IMG_DEV (dev);
+  FpImageDevice *img_dev = FP_IMAGE_DEVICE (dev);
+  FpImageDevicePrivate *priv = test_img_dev_priv (img_dev);
+  g_autoptr(FpImage) img = make_patterned_image (120, 120, FALSE, FALSE);
+  g_autoptr(FpPrint) tmpl = NULL;
+  g_autoptr(GPtrArray) gallery = g_ptr_array_new_with_free_func (g_object_unref);
+  g_autoptr(GError) error = NULL;
+  g_auto(IdentifyE2EData) data = {0};
+
+  g_assert_true (extract_sigfm_sync (img, NULL, &error));
+  g_assert_no_error (error);
+  tmpl = g_object_ref_sink (fp_print_new (dev));
+  fpi_print_set_type (tmpl, FPI_PRINT_SIGFM);
+  fp_print_set_username (tmpl, "sigfm_e2e_user");
+  g_assert_true (fpi_print_add_from_image (tmpl, img, &error));
+  g_assert_no_error (error);
+  g_ptr_array_add (gallery, g_object_ref (tmpl));
+
+  g_assert_true (fp_device_open_sync (dev, NULL, &error));
+  g_assert_no_error (error);
+
+  /* The mock activate vfunc completes activation synchronously, so by the
+   * time fp_device_identify() returns the device is already awaiting a
+   * finger. */
+  fp_device_identify (dev, gallery, NULL, identify_e2e_match_cb, &data, NULL,
+                      identify_e2e_done_cb, &data);
+
+  g_assert_cmpuint (self->activate_count, ==, 1);
+  g_assert_cmpuint (data.report_count, ==, 0);
+  g_assert_false (data.completed);
+  g_assert_true (priv->active);
+  g_assert_cmpint (priv->state, ==, FPI_IMAGE_DEVICE_STATE_AWAIT_FINGER_ON);
+  /* Finger on -> capture state, then transfer the synthetic frame to the
+   * core exactly as the driver does. The gallery template owns its extracted
+   * feature data independently, so no image reference remains needed here. */
+  fpi_image_device_report_finger_status (img_dev, TRUE);
+  g_assert_cmpint (priv->state, ==, FPI_IMAGE_DEVICE_STATE_CAPTURE);
+  fpi_image_device_image_captured (img_dev, g_steal_pointer (&img));
+  g_assert_cmpint (priv->state, ==, FPI_IMAGE_DEVICE_STATE_AWAIT_FINGER_OFF);
+
+  /* Feature extraction runs asynchronously; wait for the match report while
+   * the finger is still down. */
+  while (data.report_count == 0)
+    g_main_context_iteration (NULL, TRUE);
+  g_assert_cmpuint (data.report_count, ==, 1);
+  g_assert_no_error (data.report_error);
+  g_assert_nonnull (data.report_match);
+  g_assert_true (fp_print_equal (data.report_match, tmpl));
+  g_assert_cmpstr (fp_print_get_username (data.report_match), ==, "sigfm_e2e_user");
+  g_assert_nonnull (data.report_print);
+
+  /* Match is delivered during REARM/wait-lift: the device is waiting for
+   * finger-off, the identify task is still running and the driver has not
+   * been asked to deactivate. */
+  g_assert_cmpint (priv->state, ==, FPI_IMAGE_DEVICE_STATE_AWAIT_FINGER_OFF);
+  g_assert_true (priv->finger_present);
+  g_assert_false (priv->minutiae_scan_active);
+  g_assert_false (data.completed);
+  g_assert_cmpuint (self->deactivate_count, ==, 0);
+
+  /* Finger off -> deactivate -> identify completes cleanly. */
+  fpi_image_device_report_finger_status (img_dev, FALSE);
+  g_assert_cmpuint (self->deactivate_count, ==, 1);
+  while (!data.completed)
+    g_main_context_iteration (NULL, TRUE);
+  g_assert_true (data.identify_result);
+  g_assert_no_error (data.identify_error);
+  g_assert_nonnull (data.finish_match);
+  g_assert_true (fp_print_equal (data.finish_match, tmpl));
+
+  g_assert_false (priv->active);
+  g_assert_false (priv->finger_present);
+  g_assert_cmpint (priv->state, ==, FPI_IMAGE_DEVICE_STATE_INACTIVE);
+  g_assert_true (fp_device_close_sync (dev, NULL, &error));
+  g_assert_no_error (error);
+}
+
+typedef struct
+{
+  guint    progress_count;
+  guint    done_count;
+  FpPrint *enrolled_print; /* (owned) */
+  GError  *enroll_error;   /* (owned) */
+} EnrollFatalData;
+
+static void
+enroll_fatal_progress_cb (FpDevice *device,
+                          gint      completed_stages,
+                          FpPrint  *print,
+                          gpointer  user_data,
+                          GError   *error)
+{
+  EnrollFatalData *data = user_data;
+
+  (void) device; (void) completed_stages; (void) print; (void) error;
+  data->progress_count++;
+}
+
+static void
+enroll_fatal_done_cb (GObject      *source_object,
+                      GAsyncResult *res,
+                      gpointer      user_data)
+{
+  EnrollFatalData *data = user_data;
+
+  data->enrolled_print = fp_device_enroll_finish (FP_DEVICE (source_object),
+                                                  res,
+                                                  &data->enroll_error);
+  data->done_count++;
+}
+
+static void
+enroll_fatal_data_clear (EnrollFatalData *data)
+{
+  g_clear_object (&data->enrolled_print);
+  g_clear_error (&data->enroll_error);
+}
+G_DEFINE_AUTO_CLEANUP_CLEAR_FUNC (EnrollFatalData, enroll_fatal_data_clear)
+
+static gsize test_log_warning_count = 0;
+
+static GLogWriterOutput
+test_counting_log_writer (GLogLevelFlags   level,
+                          const GLogField *fields,
+                          gsize            n_fields,
+                          gpointer         user_data)
+{
+  if (level & (G_LOG_LEVEL_WARNING | G_LOG_LEVEL_CRITICAL | G_LOG_LEVEL_ERROR))
+    test_log_warning_count += 1;
+
+  return g_log_writer_default (level, fields, n_fields, user_data);
+}
+
+/* Regression test: a fatal session error (device removal) arriving while
+ * SIGFM feature extraction is still running must finish the enroll action
+ * exactly once with the original error. The late extraction completion must
+ * not report enroll progress, must not resurrect the state machine
+ * (INACTIVE -> AWAIT_FINGER_ON) and must not produce warnings. */
+static void
+test_sigfm_enroll_fatal_during_scan (void)
+{
+  g_autoptr(FpDevice) dev = g_object_new (FPI_TYPE_TEST_IMG_DEV, NULL);
+  FpiTestImgDev *self = FPI_TEST_IMG_DEV (dev);
+  FpImageDevice *img_dev = FP_IMAGE_DEVICE (dev);
+  FpImageDevicePrivate *priv = test_img_dev_priv (img_dev);
+  g_autoptr(FpImage) img = make_patterned_image (120, 120, FALSE, FALSE);
+  g_autoptr(FpPrint) tmpl = NULL;
+  g_autoptr(GError) error = NULL;
+  g_auto(EnrollFatalData) data = {0};
+
+  g_assert_true (extract_sigfm_sync (img, NULL, &error));
+  g_assert_no_error (error);
+
+  tmpl = g_object_ref_sink (fp_print_new (dev));
+
+  g_assert_true (fp_device_open_sync (dev, NULL, &error));
+  g_assert_no_error (error);
+
+  /* Count unexpected warnings for the duration of this test. The writer is
+   * installed once in main(); only reset the counter here. */
+  test_log_warning_count = 0;
+
+  fp_device_enroll (dev, tmpl, NULL,
+                    enroll_fatal_progress_cb, &data, NULL,
+                    enroll_fatal_done_cb, &data);
+
+  g_assert_cmpuint (self->activate_count, ==, 1);
+  g_assert_cmpint (priv->state, ==, FPI_IMAGE_DEVICE_STATE_AWAIT_FINGER_ON);
+
+  fpi_image_device_report_finger_status (img_dev, TRUE);
+  g_assert_cmpint (priv->state, ==, FPI_IMAGE_DEVICE_STATE_CAPTURE);
+  fpi_image_device_image_captured (img_dev, g_steal_pointer (&img));
+  g_assert_cmpint (priv->state, ==, FPI_IMAGE_DEVICE_STATE_AWAIT_FINGER_OFF);
+  g_assert_true (priv->minutiae_scan_active);
+
+  /* Fatal error while the asynchronous extraction is still running. The
+   * mock deactivate vfunc completes synchronously, so the device reaches
+   * INACTIVE before the extraction callback has run. */
+  fpi_image_device_session_error (img_dev, fpi_device_error_new (FP_DEVICE_ERROR_REMOVED));
+
+  g_assert_cmpuint (self->deactivate_count, ==, 1);
+  g_assert_cmpint (priv->state, ==, FPI_IMAGE_DEVICE_STATE_INACTIVE);
+  g_assert_false (priv->active);
+  /* The action must not complete while the scan is still marked active. */
+  g_assert_cmpuint (data.done_count, ==, 0);
+
+  /* The late extraction completion must silently finish the action exactly
+   * once, with the original REMOVED error. */
+  while (data.done_count == 0)
+    g_main_context_iteration (NULL, TRUE);
+
+  g_assert_cmpuint (data.done_count, ==, 1);
+  g_assert_error (data.enroll_error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_REMOVED);
+  g_assert_null (data.enrolled_print);
+  g_assert_cmpuint (data.progress_count, ==, 0);
+
+  g_assert_cmpint (priv->state, ==, FPI_IMAGE_DEVICE_STATE_INACTIVE);
+  g_assert_false (priv->active);
+  g_assert_false (priv->finger_present);
+  g_assert_false (priv->minutiae_scan_active);
+  g_assert_cmpuint (self->activate_count, ==, 1);
+  g_assert_cmpuint (self->deactivate_count, ==, 1);
+  /* Exactly 7 state transitions. A regression would add an invalid 8th
+   * transition (INACTIVE -> AWAIT_FINGER_ON). */
+  g_assert_cmpuint (self->change_state_count, ==, 7);
+
+  /* Settle: no further events may change the outcome. */
+  g_usleep (20 * 1000);
+  while (g_main_context_pending (NULL))
+    g_main_context_iteration (NULL, FALSE);
+  g_assert_cmpuint (data.done_count, ==, 1);
+  g_assert_cmpuint (data.progress_count, ==, 0);
+  g_assert_cmpuint (test_log_warning_count, ==, 0);
+
+  g_assert_true (fp_device_close_sync (dev, NULL, &error));
+  g_assert_no_error (error);
+}
+
+#else
+
+static void
+test_sigfm_skipped (void)
+{
+  g_test_skip ("SIGFM support is not enabled in this build");
+}
+
+#endif
+
+int
+main (int argc, char *argv[])
+{
+  /* Install once: g_log_set_writer_func() may only be called a single time
+   * per process. The counting wrapper lets tests assert that no warnings
+   * were emitted during critical sections. */
+  g_log_set_writer_func (test_counting_log_writer, NULL, NULL);
+
+  g_test_init (&argc, &argv, NULL);
+
+#if defined(HAVE_SIGFM) && HAVE_SIGFM
+  g_test_add_func ("/sigfm/image/extract_and_normalize", test_sigfm_image_extract_and_normalize);
+  g_test_add_func ("/sigfm/image/capture_quality_gate", test_sigfm_capture_quality_gate);
+  g_test_add_func ("/sigfm/print/equal_and_serialize", test_sigfm_print_equal_and_serialize);
+  g_test_add_func ("/sigfm/print/deserialize_corrupted", test_sigfm_deserialize_corrupted);
+  g_test_add_func ("/sigfm/print/match_and_nbis_compat", test_sigfm_match_and_nbis_compat);
+  g_test_add_func ("/sigfm/image_device/rejects_old_nbis", test_sigfm_image_device_rejects_old_nbis);
+  g_test_add_func ("/sigfm/image_device/enroll_antidup", test_sigfm_enroll_antidup);
+  g_test_add_func ("/sigfm/image_device/deferred_deactivation", test_sigfm_deferred_deactivation);
+  g_test_add_func ("/sigfm/image_device/verify_retry", test_sigfm_verify_retry);
+  g_test_add_func ("/sigfm/image_device/identify_empty_gallery", test_sigfm_identify_empty_gallery);
+  g_test_add_func ("/sigfm/image_device/identify_match_before_finger_off", test_sigfm_identify_match_before_finger_off);
+  g_test_add_func ("/sigfm/image_device/enroll_fatal_during_scan", test_sigfm_enroll_fatal_during_scan);
+#else
+  g_test_add_func ("/sigfm/skipped", test_sigfm_skipped);
+#endif
+
+  return g_test_run ();
+}

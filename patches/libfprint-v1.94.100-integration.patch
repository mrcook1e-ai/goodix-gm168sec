+static void
+test_sigfm_identify_empty_gallery (void)
+{
+  g_autoptr(FpDevice) dev = g_object_new (FPI_TYPE_TEST_IMG_DEV, NULL);
+  FpiTestImgDev *self = FPI_TEST_IMG_DEV (dev);
+  FpImageDevicePrivate *priv = test_img_dev_priv (FP_IMAGE_DEVICE (dev));
+  g_autoptr(GPtrArray) gallery = g_ptr_array_new_with_free_func (g_object_unref);
+  g_autoptr(FpPrint) match = NULL;
+  g_autoptr(FpPrint) print = NULL;
+  g_autoptr(GError) error = NULL;
+  g_auto(IdentifyE2EData) data = {0};
+
+  /* Even with auto-retries enabled, an empty gallery must not cost the user
+   * a single touch: the action is known upfront to be a no-match. */
+  fpi_image_device_set_sigfm_verify_retries (FP_IMAGE_DEVICE (dev), 2);
+
+  g_assert_true (fp_device_open_sync (dev, NULL, &error));
+  g_assert_no_error (error);
+
+  g_assert_true (fp_device_identify_sync (dev, gallery, NULL,
+                                          identify_e2e_match_cb, &data,
+                                          &match, &print, &error));
+  g_assert_no_error (error);
+  g_assert_null (match);
+  g_assert_null (print);
+
+  /* Exactly one identify report: NULL match, NULL print, no error. */
+  g_assert_cmpuint (data.report_count, ==, 1);
+  g_assert_null (data.report_match);
+  g_assert_null (data.report_print);
+  g_assert_no_error (data.report_error);
+
+  /* No sensor activation, no state transitions, no deactivation, no retry. */
+  g_assert_cmpuint (self->activate_count, ==, 0);
+  g_assert_cmpuint (self->change_state_count, ==, 0);
+  g_assert_cmpuint (self->deactivate_count, ==, 0);
+  g_assert_false (priv->active);
+  g_assert_cmpint (priv->state, ==, FPI_IMAGE_DEVICE_STATE_INACTIVE);
+  g_assert_false (priv->minutiae_scan_active);
+  g_assert_cmpint (priv->verify_retry_count, ==, 0);
+  g_assert_false (priv->verify_retry_pending);
+
+  /* Device is left in a clean state: a second identify also completes
+   * immediately as no-match with exactly one more report. */
+  g_assert_true (fp_device_identify_sync (dev, gallery, NULL,
+                                          identify_e2e_match_cb, &data,
+                                          &match, &print, &error));
+  g_assert_no_error (error);
+  g_assert_null (match);
+  g_assert_null (print);
+  g_assert_cmpuint (data.report_count, ==, 2);
+  g_assert_null (data.report_match);
+  g_assert_null (data.report_print);
+  g_assert_no_error (data.report_error);
+  g_assert_cmpuint (self->activate_count, ==, 0);
+  g_assert_cmpuint (self->change_state_count, ==, 0);
+
+  g_assert_true (fp_device_close_sync (dev, NULL, &error));
+  g_assert_no_error (error);
+}

new file mode 100644
index 0000000..3fc3add
--- /dev/null
+++ b/tests/test-goodix-gm168-frame-layout.c
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Synthetic Goodix GM168SEC frame-layout and 12-bit decoder test. */
+
+#include <glib.h>
+
+#include "drivers/goodix_gm168/gm168_frame_layout.h"
+
+static void
+test_stream_to_image_index (void)
+{
+  gboolean seen[GM168_FRAME_PIXELS] = { 0 };
+
+  g_assert_cmpuint (GM168_FRAME_W, ==, 80);
+  g_assert_cmpuint (GM168_FRAME_H, ==, 64);
+  g_assert_cmpuint (GM168_FRAME_PIXELS, ==, 5120);
+  g_assert_cmpuint (GM168_OUTPUT_W, ==, 160);
+  g_assert_cmpuint (GM168_OUTPUT_H, ==, 128);
+
+  g_assert_cmpuint (gm168_stream_to_image_index (0), ==, 0);
+  g_assert_cmpuint (gm168_stream_to_image_index (1), ==, GM168_FRAME_W);
+  g_assert_cmpuint (gm168_stream_to_image_index (63), ==, 63 * GM168_FRAME_W);
+  g_assert_cmpuint (gm168_stream_to_image_index (64), ==, 1);
+  g_assert_cmpuint (gm168_stream_to_image_index (5119), ==, GM168_FRAME_PIXELS - 1);
+
+  for (guint i = 0; i < GM168_FRAME_PIXELS; i++)
+    {
+      guint image_index = gm168_stream_to_image_index (i);
+
+      g_assert_cmpuint (image_index, <, GM168_FRAME_PIXELS);
+      g_assert_false (seen[image_index]);
+      seen[image_index] = TRUE;
+    }
+}
+
+static void
+test_decode_packed_frame (void)
+{
+  guint8 wire[GM168_TLS_FRAME_SIZE];
+  guint16 expected_stream[GM168_FRAME_PIXELS];
+  guint16 decoded[GM168_FRAME_PIXELS] = { 0 };
+
+  /* Non-zero padding/trailer proves that only the 96 data bytes per 132-byte
+   * wire row participate in decoding. */
+  memset (wire, 0xA5, sizeof (wire));
+
+  for (guint k = 0; k < GM168_FRAME_PIXELS; k++)
+    expected_stream[k] = (guint16) ((k * 257U + k / 7U) & 0x0FFFU);
+
+  for (guint k = 0; k < GM168_FRAME_PIXELS; k += 4)
+    {
+      guint16 p0 = expected_stream[k];
+      guint16 p1 = expected_stream[k + 1];
+      guint16 p2 = expected_stream[k + 2];
+      guint16 p3 = expected_stream[k + 3];
+      guint compact = (k / 4U) * 6U;
+      guint row = compact / GM168_WIRE_ROW_DATA;
+      guint column = compact % GM168_WIRE_ROW_DATA;
+      guint8 *dst = wire + row * GM168_WIRE_ROW_STRIDE + column;
+
+      dst[0] = (guint8) (((p0 >> 8) & 0x0FU) | ((p1 & 0x0FU) << 4));
+      dst[1] = (guint8) (p0 & 0xFFU);
+      dst[2] = (guint8) (p2 & 0xFFU);
+      dst[3] = (guint8) (p1 >> 4);
+      dst[4] = (guint8) (p3 >> 4);
+      dst[5] = (guint8) (((p2 >> 8) & 0x0FU) | ((p3 & 0x0FU) << 4));
+    }
+
+  g_assert_cmpint (gm168_decode_frame (wire, sizeof (wire), decoded), ==, 0);
+  for (guint k = 0; k < GM168_FRAME_PIXELS; k++)
+    g_assert_cmpuint (decoded[gm168_stream_to_image_index (k)], ==,
+                      expected_stream[k]);
+
+  g_assert_cmpint (gm168_decode_frame (wire, GM168_TLS_PAYLOAD_SIZE - 1, decoded), ==, -1);
+  g_assert_cmpint (gm168_decode_frame (NULL, sizeof (wire), decoded), ==, -1);
+  g_assert_cmpint (gm168_decode_frame (wire, sizeof (wire), NULL), ==, -1);
+}
+
+int
+main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/goodix-gm168/stream-to-image-index",
+                   test_stream_to_image_index);
+  g_test_add_func ("/goodix-gm168/decode-packed-frame",
+                   test_decode_packed_frame);
+
+  return g_test_run ();
+}

+static void
+test_sigfm_enroll_antidup (void)
+{
+  g_autoptr(FpDevice) dev = g_object_new (FPI_TYPE_TEST_IMG_DEV, NULL);
+  g_autoptr(FpImage) img1 = make_patterned_image (120, 120, FALSE, FALSE);
+  g_autoptr(FpImage) img2 = make_patterned_image (120, 120, FALSE, FALSE);
+  g_autoptr(FpPrint) tmpl = NULL;
+  g_autoptr(FpPrint) p1 = NULL;
+  g_autoptr(FpPrint) p2 = NULL;
+  g_autoptr(FpPrint) p_nbis = NULL;
+  g_autoptr(GError) error = NULL;
+  gint max_score = -1;
+
+  for (gint i = 0; i < 120 * 120; i++)
+    img2->data[i] = (guint8) ((img2->data[i] * 3 + (i % 97)) & 0xff);
+
+  g_assert_true (extract_sigfm_sync (img1, NULL, &error));
+  g_assert_no_error (error);
+  g_assert_true (extract_sigfm_sync (img2, NULL, &error));
+  g_assert_no_error (error);
+
+  tmpl = g_object_ref_sink (fp_print_new (dev));
+  fpi_print_set_type (tmpl, FPI_PRINT_SIGFM);
+  p1 = g_object_ref_sink (fp_print_new (dev));
+  fpi_print_set_type (p1, FPI_PRINT_SIGFM);
+  g_assert_true (fpi_print_add_from_image (p1, img1, &error));
+  g_assert_no_error (error);
+
+  p2 = g_object_ref_sink (fp_print_new (dev));
+  fpi_print_set_type (p2, FPI_PRINT_SIGFM);
+  g_assert_true (fpi_print_add_from_image (p2, img2, &error));
+  g_assert_no_error (error);
+
+  /* Empty template returns 0 cleanly */
+  g_assert_true (fpi_print_sigfm_max_score (tmpl, p1, &max_score, &error));
+  g_assert_no_error (error);
+  g_assert_cmpint (max_score, ==, 0);
+
+  /* Matching against populated template returns high score >= 20 */
+  fpi_print_add_print (tmpl, p1);
+  g_assert_true (fpi_print_sigfm_max_score (tmpl, p1, &max_score, &error));
+  g_assert_no_error (error);
+  g_assert_cmpint (max_score, >=, 20);
+
+  /* Non-matching print stays below duplicate threshold */
+  g_assert_true (fpi_print_sigfm_max_score (tmpl, p2, &max_score, &error));
+  g_assert_no_error (error);
+  g_assert_cmpint (max_score, <, 15);
+
+  /* Multi-entry template returns max across entries */
+  fpi_print_add_print (tmpl, p2);
+  g_assert_true (fpi_print_sigfm_max_score (tmpl, p2, &max_score, &error));
+  g_assert_no_error (error);
+  g_assert_cmpint (max_score, >=, 20);
+
+  /* Incompatible NBIS print fails cleanly */
+  p_nbis = g_object_ref_sink (fp_print_new (dev));
+  fpi_print_set_type (p_nbis, FPI_PRINT_NBIS);
+  g_assert_false (fpi_print_sigfm_max_score (p_nbis, p1, &max_score, &error));
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_NOT_SUPPORTED);
+  g_clear_error (&error);
+
+  /* Threshold setter accepts 0 (disable) and positive values */
+  fpi_image_device_set_sigfm_dup_threshold (FP_IMAGE_DEVICE (dev), 15);
+  fpi_image_device_set_sigfm_dup_threshold (FP_IMAGE_DEVICE (dev), 0);
+}

+/* Deterministic synthetic fingerprint-like pattern with rich keypoints */
+static FpImage *
+make_patterned_image (gint width, gint height, gboolean inverted, gboolean hflipped)
+{
+  FpImage *img = fp_image_new (width, height);
+  gint x, y;
+
+  for (y = 0; y < height; y++)
+    {
+      for (x = 0; x < width; x++)
+        {
+          double dx = x - width * 0.45;
+          double dy = y - height * 0.52;
+          double r = sqrt (dx * dx + dy * dy);
+          double theta = atan2 (dy, dx);
+          double v = sin (r * 0.55 + 1.5 * theta) +
+                     0.45 * cos (x * 0.42) * sin (y * 0.37) +
+                     0.25 * sin ((x + y) * 0.71);
+          int val = (int) (128.0 + 60.0 * v);
+
+          if (val < 0)
+            val = 0;
+          if (val > 255)
+            val = 255;
+
+          img->data[y * width + x] = (guint8) val;
+        }
+    }
+
+  if (hflipped)
+    img->flags |= FPI_IMAGE_H_FLIPPED;
+  if (inverted)
+    img->flags |= FPI_IMAGE_COLORS_INVERTED;
+
+  return img;
+}
+
+static void
+extract_sync_cb (GObject *source_object, GAsyncResult *res, gpointer user_data)
+{
+  GAsyncResult **out_res = user_data;
+
+  *out_res = g_object_ref (res);
+}
+
+static gboolean
+extract_sigfm_sync (FpImage *img, GCancellable *cancellable, GError **error)
+{
+  g_autoptr(GAsyncResult) res = NULL;
+
+  fpi_image_extract_sigfm_info (img, cancellable, extract_sync_cb, &res);
+  while (!res)
+    g_main_context_iteration (NULL, TRUE);
+
+  return fpi_image_extract_sigfm_info_finish (img, res, error);
+}
+
+static void
+test_sigfm_image_extract_and_normalize (void)
+{
+  g_autoptr(FpImage) img_plain = make_patterned_image (120, 120, FALSE, FALSE);
+  g_autoptr(FpImage) img_inv = make_patterned_image (120, 120, TRUE, TRUE);
+  g_autoptr(FpImage) img_blank = fp_image_new (120, 120);
+  g_autoptr(GCancellable) cancellable = g_cancellable_new ();
+  g_autoptr(GAsyncResult) res1 = NULL;
+  g_autoptr(GAsyncResult) res2 = NULL;
+  g_autoptr(GError) error = NULL;
+  gsize len_plain = 0, len_inv = 0;
+  const guint8 *data_plain, *data_inv;
+  guint i;
+
+  g_assert_true (extract_sigfm_sync (img_plain, NULL, &error));
+  g_assert_no_error (error);
+  g_assert_nonnull (fpi_image_get_sigfm_info (img_plain));
+
+  /* Inverted + H_FLIPPED image must be normalized to match plain data */
+  for (i = 0; i < 120 * 120; i++)
+    img_inv->data[i] = 0xff - img_inv->data[i];
+  /* Also undo hflip manually on raw input so after hflip+invert it equals img_plain */
+  for (gint y = 0; y < 120; y++)
+    {
+      for (gint x = 0; x < 60; x++)
+        {
+          guint8 tmp = img_inv->data[y * 120 + x];
+          img_inv->data[y * 120 + x] = img_inv->data[y * 120 + (119 - x)];
+          img_inv->data[y * 120 + (119 - x)] = tmp;
+        }
+    }
+
+  g_assert_true (extract_sigfm_sync (img_inv, NULL, &error));
+  g_assert_no_error (error);
+  g_assert_cmpuint (img_inv->flags & (FPI_IMAGE_H_FLIPPED | FPI_IMAGE_V_FLIPPED | FPI_IMAGE_COLORS_INVERTED), ==, 0);
+
+  data_plain = fp_image_get_data (img_plain, &len_plain);
+  data_inv = fp_image_get_data (img_inv, &len_inv);
+  g_assert_cmpuint (len_plain, ==, len_inv);
+  g_assert_cmpmem (data_plain, len_plain, data_inv, len_inv);
+
+  /* Blank images are valid extraction results; FpImageDevice's quality gate
+   * classifies their zero keypoints as a centered-finger retry. */
+  g_assert_true (extract_sigfm_sync (img_blank, NULL, &error));
+  g_assert_no_error (error);
+  g_assert_nonnull (fpi_image_get_sigfm_info (img_blank));
+  g_assert_cmpint (sigfm_keypoints_count (fpi_image_get_sigfm_info (img_blank)), ==, 0);
+  g_assert_cmpfloat (fpi_image_get_sigfm_coverage (img_blank), ==, 0.0);
+
+  /* Empty 0x0 + flip/invert flags and NULL data -> G_IO_ERROR_INVALID_DATA without crash */
+  {
+    g_autoptr(FpImage) img_empty = fp_image_new (0, 0);
+    g_autoptr(FpImage) img_null = fp_image_new (10, 10);
+
+    img_empty->flags = FPI_IMAGE_H_FLIPPED | FPI_IMAGE_V_FLIPPED | FPI_IMAGE_COLORS_INVERTED;
+    g_assert_false (extract_sigfm_sync (img_empty, NULL, &error));
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+    g_clear_error (&error);
+
+    g_clear_pointer (&img_null->data, g_free);
+    g_assert_false (extract_sigfm_sync (img_null, NULL, &error));
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+    g_clear_error (&error);
+  }
+
+  /* V_FLIPPED + PARTIAL normalization preserves PARTIAL and matches plain data */
+  {
+    g_autoptr(FpImage) img_vflip = make_patterned_image (120, 120, FALSE, FALSE);
+    const guint8 *data_vflip;
+    gsize len_vflip = 0;
+
+    for (gint y = 0; y < 60; y++)
+      {
+        for (gint x = 0; x < 120; x++)
+          {
+            guint8 tmp = img_vflip->data[y * 120 + x];
+            img_vflip->data[y * 120 + x] = img_vflip->data[(119 - y) * 120 + x];
+            img_vflip->data[(119 - y) * 120 + x] = tmp;
+          }
+      }
+    img_vflip->flags |= FPI_IMAGE_V_FLIPPED | FPI_IMAGE_PARTIAL;
+
+    g_assert_true (extract_sigfm_sync (img_vflip, NULL, &error));
+    g_assert_no_error (error);
+    g_assert_cmpuint (img_vflip->flags & (FPI_IMAGE_V_FLIPPED | FPI_IMAGE_PARTIAL), ==,
+                      FPI_IMAGE_PARTIAL);
+
+    data_vflip = fp_image_get_data (img_vflip, &len_vflip);
+    g_assert_cmpuint (len_vflip, ==, len_plain);
+    g_assert_cmpmem (data_plain, len_plain, data_vflip, len_vflip);
+  }
+
+  /* Cancelled before start */
+  g_cancellable_cancel (cancellable);
+  g_assert_false (extract_sigfm_sync (img_blank, cancellable, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_CANCELLED);
+  g_clear_error (&error);
+
+  /* Concurrent detection guard + retry after ADDRESS_IN_USE */
+  {
+    g_autoptr(FpImage) img_retry = make_patterned_image (120, 120, FALSE, FALSE);
+
+    fpi_image_extract_sigfm_info (img_retry, NULL, extract_sync_cb, &res1);
+    fpi_image_extract_sigfm_info (img_retry, NULL, extract_sync_cb, &res2);
+    while (!res1 || !res2)
+      g_main_context_iteration (NULL, TRUE);
+    g_assert_false (fpi_image_extract_sigfm_info_finish (img_retry, res2, &error));
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_ADDRESS_IN_USE);
+    g_clear_error (&error);
+    g_assert_true (fpi_image_extract_sigfm_info_finish (img_retry, res1, &error));
+    g_assert_no_error (error);
+
+    g_assert_true (extract_sigfm_sync (img_retry, NULL, &error));
+    g_assert_no_error (error);
+  }
+}
+
+static void
+test_sigfm_capture_quality_gate (void)
+{
+  g_autoptr(FpDevice) dev = g_object_new (FPI_TYPE_TEST_IMG_DEV, NULL);
+  FpImageDevice *img_dev = FP_IMAGE_DEVICE (dev);
+  g_autoptr(FpImage) good = make_patterned_image (120, 120, FALSE, FALSE);
+  g_autoptr(FpImage) blank = fp_image_new (120, 120);
+  g_autoptr(FpImage) partial = make_patterned_image (120, 120, FALSE, FALSE);
+  g_autoptr(GError) error = NULL;
+  SigfmImgInfo *partial_info;
+  gdouble partial_coverage;
+
+  g_assert_true (extract_sigfm_sync (good, NULL, &error));
+  g_assert_no_error (error);
+  g_assert_true (extract_sigfm_sync (blank, NULL, &error));
+  g_assert_no_error (error);
+
+  fpi_image_device_set_sigfm_quality_gate (img_dev, 30, 0.55);
+
+  g_assert_true (fpi_image_device_check_sigfm_quality (img_dev, good, TRUE, &error));
+  g_assert_no_error (error);
+
+  g_assert_false (fpi_image_device_check_sigfm_quality (img_dev, blank, FALSE, &error));
+  g_assert_error (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_CENTER_FINGER);
+  g_clear_error (&error);
+
+  /* Preserve high-contrast texture only in the left third: enough keypoints
+   * for matching, but insufficient spatial coverage for enrollment/no-match. */
+  for (gint y = 0; y < 120; y++)
+    for (gint x = 40; x < 120; x++)
+      partial->data[y * 120 + x] = 128;
+
+  g_assert_true (extract_sigfm_sync (partial, NULL, &error));
+  g_assert_no_error (error);
+  partial_info = fpi_image_get_sigfm_info (partial);
+  partial_coverage = fpi_image_get_sigfm_coverage (partial);
+  g_assert_cmpint (sigfm_keypoints_count (partial_info), >=, 30);
+  g_assert_cmpfloat (partial_coverage, <, 0.55);
+
+  /* Verify performs matching before applying the coverage-only retry. */
+  g_assert_true (fpi_image_device_check_sigfm_quality (img_dev, partial, FALSE, &error));
+  g_assert_no_error (error);
+  g_assert_false (fpi_image_device_check_sigfm_quality (img_dev, partial, TRUE, &error));
+  g_assert_error (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_CENTER_FINGER);
+  g_clear_error (&error);
+}
+
+static void
+test_sigfm_print_equal_and_serialize (void)
+{
+  g_autoptr(FpDevice) dev = g_object_new (FPI_TYPE_TEST_IMG_DEV, NULL);
+  g_autoptr(FpImage) img1 = make_patterned_image (120, 120, FALSE, FALSE);
+  g_autoptr(FpImage) img2 = make_patterned_image (120, 120, FALSE, FALSE);
+  g_autoptr(FpPrint) p1 = NULL;
+  g_autoptr(FpPrint) p2 = NULL;
+  g_autoptr(FpPrint) p_nbis = NULL;
+  g_autoptr(FpPrint) p_undef = NULL;
+  g_autoptr(FpPrint) p_deser = NULL;
+  g_autoptr(GError) error = NULL;
+  g_autofree guchar *data = NULL;
+  gsize len = 0;
+
+  /* Modify img2 slightly so its features differ */
+  for (gint i = 0; i < 120 * 60; i++)
+    img2->data[i] = (guint8) ((img2->data[i] + 40) & 0xff);
+
+  g_assert_true (extract_sigfm_sync (img1, NULL, &error));
+  g_assert_no_error (error);
+  g_assert_true (extract_sigfm_sync (img2, NULL, &error));
+  g_assert_no_error (error);
+
+  p1 = g_object_ref_sink (fp_print_new (dev));
+  fpi_print_set_type (p1, FPI_PRINT_SIGFM);
+  fp_print_set_finger (p1, FP_FINGER_RIGHT_INDEX);
+  fp_print_set_username (p1, "sigfm_user");
+  fp_print_set_description (p1, "sigfm test");
+  g_assert_true (fpi_print_add_from_image (p1, img1, &error));
+  g_assert_no_error (error);
+
+  /* Multi-entry template via fpi_print_add_print */
+  {
+    g_autoptr(FpPrint) p_extra = g_object_ref_sink (fp_print_new (dev));
+    fpi_print_set_type (p_extra, FPI_PRINT_SIGFM);
+    g_assert_true (fpi_print_add_from_image (p_extra, img2, &error));
+    g_assert_no_error (error);
+    fpi_print_add_print (p1, p_extra);
+  }
+
+  p2 = g_object_ref_sink (fp_print_new (dev));
+  fpi_print_set_type (p2, FPI_PRINT_SIGFM);
+  g_assert_true (fpi_print_add_from_image (p2, img2, &error));
+  g_assert_no_error (error);
+  g_assert_false (fp_print_equal (p1, p2));
+
+  p_nbis = g_object_ref_sink (fp_print_new (dev));
+  fpi_print_set_type (p_nbis, FPI_PRINT_NBIS);
+  g_assert_false (fp_print_equal (p1, p_nbis));
+
+  /* Serialize & deserialize round-trip */
+  g_assert_true (fp_print_serialize (p1, &data, &len, &error));
+  g_assert_no_error (error);
+  g_assert_nonnull (data);
+  g_assert_cmpuint (len, >, 3);
+
+  p_deser = fp_print_deserialize (data, len, &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (p_deser);
+  g_assert_cmpint (fpi_print_get_type (p_deser), ==, FPI_PRINT_SIGFM);
+  g_assert_true (fp_print_equal (p1, p_deser));
+  g_assert_cmpstr (fp_print_get_username (p_deser), ==, "sigfm_user");
+  g_assert_cmpstr (fp_print_get_description (p_deser), ==, "sigfm test");
+  g_assert_cmpint (fp_print_get_finger (p_deser), ==, FP_FINGER_RIGHT_INDEX);
+
+  /* Undefined print must fail serialization cleanly */
+  p_undef = g_object_ref_sink (fp_print_new (dev));
+  {
+    g_autofree guchar *bad_data = NULL;
+    gsize bad_len = 0;
+
+    g_assert_false (fp_print_serialize (p_undef, &bad_data, &bad_len, &error));
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+    g_clear_error (&error);
+  }
+}
+
+static void
+test_sigfm_deserialize_corrupted (void)
+{
+  const guchar short_buf[] = { 'F', 'P' };
+  const guchar bad_magic[] = { 'F', 'P', '2', 0, 0, 0, 0 };
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GVariant) bad_inner = NULL;
+  g_autoptr(GVariant) bad_outer = NULL;
+  g_autofree guchar *wire = NULL;
+  gsize wlen;
+
+  g_assert_null (fp_print_deserialize (short_buf, sizeof (short_buf), &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+  g_clear_error (&error);
+
+  g_assert_null (fp_print_deserialize (bad_magic, sizeof (bad_magic), &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+  g_clear_error (&error);
+
+  /* Valid FP3 wrapper with FPI_PRINT_SIGFM type, but wrong inner variant type */
+  {
+    GVariantBuilder builder = G_VARIANT_BUILDER_INIT (G_VARIANT_TYPE ("(issbymsmsia{sv}v)"));
+    const guchar garbage[] = { 1, 2, 3, 4, 5 };
+
+    g_variant_builder_add (&builder, "i", FPI_PRINT_SIGFM);
+    g_variant_builder_add (&builder, "s", "test_sigfm_img");
+    g_variant_builder_add (&builder, "s", "0");
+    g_variant_builder_add (&builder, "b", FALSE);
+    g_variant_builder_add (&builder, "y", FP_FINGER_UNKNOWN);
+    g_variant_builder_add (&builder, "ms", (const gchar *) NULL);
+    g_variant_builder_add (&builder, "ms", (const gchar *) NULL);
+    g_variant_builder_add (&builder, "i", G_MININT32);
+    g_variant_builder_open (&builder, G_VARIANT_TYPE_VARDICT);
+    g_variant_builder_close (&builder);
+
+    bad_inner = g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, garbage, sizeof (garbage), 1);
+    g_variant_builder_add (&builder, "v", g_steal_pointer (&bad_inner));
+    bad_outer = g_variant_builder_end (&builder);
+
+    wlen = g_variant_get_size (bad_outer) + 3;
+    wire = g_malloc (wlen);
+    wire[0] = 'F';
+    wire[1] = 'P';
+    wire[2] = '3';
+    g_variant_get_data (bad_outer);
+    g_variant_store (bad_outer, wire + 3);
+
+    g_assert_null (fp_print_deserialize (wire, wlen, &error));
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+    g_clear_error (&error);
+  }
+
+  /* Unknown print type (e.g. 99) */
+  {
+    GVariantBuilder builder = G_VARIANT_BUILDER_INIT (G_VARIANT_TYPE ("(issbymsmsia{sv}v)"));
+    g_autoptr(GVariant) outer = NULL;
+    g_autofree guchar *raw = NULL;
+    gsize rlen;
+
+    g_variant_builder_add (&builder, "i", 99);
+    g_variant_builder_add (&builder, "s", "test_sigfm_img");
+    g_variant_builder_add (&builder, "s", "0");
+    g_variant_builder_add (&builder, "b", FALSE);
+    g_variant_builder_add (&builder, "y", FP_FINGER_UNKNOWN);
+    g_variant_builder_add (&builder, "ms", (const gchar *) NULL);
+    g_variant_builder_add (&builder, "ms", (const gchar *) NULL);
+    g_variant_builder_add (&builder, "i", G_MININT32);
+    g_variant_builder_open (&builder, G_VARIANT_TYPE_VARDICT);
+    g_variant_builder_close (&builder);
+    g_variant_builder_add (&builder, "v", g_variant_new_string ("bad"));
+    outer = g_variant_builder_end (&builder);
+
+    rlen = g_variant_get_size (outer) + 3;
+    raw = g_malloc (rlen);
+    raw[0] = 'F';
+    raw[1] = 'P';
+    raw[2] = '3';
+    g_variant_get_data (outer);
+    g_variant_store (outer, raw + 3);
+
+    g_test_expect_message ("libfprint-print", G_LOG_LEVEL_WARNING, "*Invalid print type*");
+    g_assert_null (fp_print_deserialize (raw, rlen, &error));
+    g_test_assert_expected_messages ();
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+    g_clear_error (&error);
+  }
+}

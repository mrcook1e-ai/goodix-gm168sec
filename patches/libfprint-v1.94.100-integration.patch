+static void
+test_sigfm_verify_retry (void)
+{
+  g_autoptr(FpiTestImgDevAutoResetClass) cls_reset = auto_reset_img_dev_class ();
+  g_autoptr(FpDevice) dev = g_object_new (FPI_TYPE_TEST_IMG_DEV, NULL);
+  FpImageDevice *img_dev = FP_IMAGE_DEVICE (dev);
+  g_autoptr(FpImage) img = make_patterned_image (120, 120, FALSE, FALSE);
+  g_autoptr(FpPrint) tmpl = NULL;
+  g_autoptr(FpPrint) scan = NULL;
+  g_autoptr(GError) error = NULL;
+
+  (void) cls_reset;
+
+  g_assert_true (extract_sigfm_sync (img, NULL, &error));
+  g_assert_no_error (error);
+  tmpl = g_object_ref_sink (fp_print_new (dev));
+  fpi_print_set_type (tmpl, FPI_PRINT_SIGFM);
+  g_assert_true (fpi_print_add_from_image (tmpl, img, &error));
+  g_assert_no_error (error);
+
+  /* 1. Default retries=0: immediate no-match without FP_DEVICE_RETRY */
+  scan = g_object_ref_sink (fp_print_new (dev));
+  fpi_image_device_apply_sigfm_verify_retry (img_dev, NULL, &scan, &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (scan);
+  g_clear_object (&scan);
+
+  /* 2. retries=2: no-match -> retry (1/2) -> retry (2/2) -> final no-match */
+  fpi_image_device_set_sigfm_verify_retries (img_dev, 2);
+
+  scan = g_object_ref_sink (fp_print_new (dev));
+  fpi_image_device_apply_sigfm_verify_retry (img_dev, NULL, &scan, &error);
+  g_assert_error (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_GENERAL);
+  g_assert_null (scan);
+  g_clear_error (&error);
+
+  scan = g_object_ref_sink (fp_print_new (dev));
+  fpi_image_device_apply_sigfm_verify_retry (img_dev, NULL, &scan, &error);
+  g_assert_error (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_GENERAL);
+  g_assert_null (scan);
+  g_clear_error (&error);
+
+  scan = g_object_ref_sink (fp_print_new (dev));
+  fpi_image_device_apply_sigfm_verify_retry (img_dev, NULL, &scan, &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (scan);
+  g_clear_object (&scan);
+
+  /* 3. retries=2: no-match -> retry (1/2) -> match completes immediately & resets counter */
+  scan = g_object_ref_sink (fp_print_new (dev));
+  fpi_image_device_apply_sigfm_verify_retry (img_dev, NULL, &scan, &error);
+  g_assert_error (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_GENERAL);
+  g_clear_error (&error);
+
+  scan = g_object_ref_sink (fp_print_new (dev));
+  fpi_image_device_apply_sigfm_verify_retry (img_dev, tmpl, &scan, &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (scan);
+  g_clear_object (&scan);
+
+  /* Next session starts fresh (counter was reset on match) */
+  scan = g_object_ref_sink (fp_print_new (dev));
+  fpi_image_device_apply_sigfm_verify_retry (img_dev, NULL, &scan, &error);
+  g_assert_error (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_GENERAL);
+  g_clear_error (&error);
+
+  /* Reset counter cleanly via retries=0 */
+  fpi_image_device_set_sigfm_verify_retries (img_dev, 0);
+  scan = g_object_ref_sink (fp_print_new (dev));
+  fpi_image_device_apply_sigfm_verify_retry (img_dev, NULL, &scan, &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (scan);
+  g_clear_object (&scan);
+
+  /* 4. NBIS device is never retried even if retries > 0 */
+  {
+    FpImageDeviceClass *cls = FP_IMAGE_DEVICE_CLASS (g_type_class_peek_static (FPI_TYPE_TEST_IMG_DEV));
+    g_autoptr(FpDevice) nbis_dev = NULL;
+
+    cls->algorithm = FPI_PRINT_NBIS;
+    nbis_dev = g_object_new (FPI_TYPE_TEST_IMG_DEV, NULL);
+    fpi_image_device_set_sigfm_verify_retries (FP_IMAGE_DEVICE (nbis_dev), 2);
+    scan = g_object_ref_sink (fp_print_new (nbis_dev));
+    fpi_image_device_apply_sigfm_verify_retry (FP_IMAGE_DEVICE (nbis_dev), NULL, &scan, &error);
+    g_assert_no_error (error);
+    g_assert_nonnull (scan);
+    g_clear_object (&scan);
+  }
+}
+
+#else
+
+static void
+test_sigfm_skipped (void)
+{
+  g_test_skip ("SIGFM support is not enabled in this build");
+}
+
+#endif
+
+int
+main (int argc, char *argv[])
+{
+  g_test_init (&argc, &argv, NULL);
+
+#if defined(HAVE_SIGFM) && HAVE_SIGFM
+  g_test_add_func ("/sigfm/image/extract_and_normalize", test_sigfm_image_extract_and_normalize);
+  g_test_add_func ("/sigfm/print/equal_and_serialize", test_sigfm_print_equal_and_serialize);
+  g_test_add_func ("/sigfm/print/deserialize_corrupted", test_sigfm_deserialize_corrupted);
+  g_test_add_func ("/sigfm/print/match_and_nbis_compat", test_sigfm_match_and_nbis_compat);
+  g_test_add_func ("/sigfm/image_device/rejects_old_nbis", test_sigfm_image_device_rejects_old_nbis);
+  g_test_add_func ("/sigfm/image_device/enroll_antidup", test_sigfm_enroll_antidup);
+  g_test_add_func ("/sigfm/image_device/verify_retry", test_sigfm_verify_retry);
+#else
+  g_test_add_func ("/sigfm/skipped", test_sigfm_skipped);
+#endif
+
+  return g_test_run ();
+}

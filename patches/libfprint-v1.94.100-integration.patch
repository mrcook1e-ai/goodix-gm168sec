+static void
+test_sigfm_deserialize_corrupted (void)
+{
+  const guchar short_buf[] = { 'F', 'P' };
+  const guchar bad_magic[] = { 'F', 'P', '2', 0, 0, 0, 0 };
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GVariant) bad_inner = NULL;
+  g_autoptr(GVariant) bad_outer = NULL;
+  g_autofree guchar *wire = NULL;
+  gsize wlen;
+
+  g_assert_null (fp_print_deserialize (short_buf, sizeof (short_buf), &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+  g_clear_error (&error);
+
+  g_assert_null (fp_print_deserialize (bad_magic, sizeof (bad_magic), &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+  g_clear_error (&error);
+
+  /* Valid FP3 wrapper with FPI_PRINT_SIGFM type, but wrong inner variant type */
+  {
+    GVariantBuilder builder = G_VARIANT_BUILDER_INIT (G_VARIANT_TYPE ("(issbymsmsia{sv}v)"));
+    const guchar garbage[] = { 1, 2, 3, 4, 5 };
+
+    g_variant_builder_add (&builder, "i", FPI_PRINT_SIGFM);
+    g_variant_builder_add (&builder, "s", "test_sigfm_img");
+    g_variant_builder_add (&builder, "s", "0");
+    g_variant_builder_add (&builder, "b", FALSE);
+    g_variant_builder_add (&builder, "y", FP_FINGER_UNKNOWN);
+    g_variant_builder_add (&builder, "ms", (const gchar *) NULL);
+    g_variant_builder_add (&builder, "ms", (const gchar *) NULL);
+    g_variant_builder_add (&builder, "i", G_MININT32);
+    g_variant_builder_open (&builder, G_VARIANT_TYPE_VARDICT);
+    g_variant_builder_close (&builder);
+
+    bad_inner = g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, garbage, sizeof (garbage), 1);
+    g_variant_builder_add (&builder, "v", g_steal_pointer (&bad_inner));
+    bad_outer = g_variant_builder_end (&builder);
+
+    wlen = g_variant_get_size (bad_outer) + 3;
+    wire = g_malloc (wlen);
+    wire[0] = 'F';
+    wire[1] = 'P';
+    wire[2] = '3';
+    g_variant_get_data (bad_outer);
+    g_variant_store (bad_outer, wire + 3);
+
+    g_assert_null (fp_print_deserialize (wire, wlen, &error));
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+    g_clear_error (&error);
+  }
+
+  /* Unknown print type (e.g. 99) */
+  {
+    GVariantBuilder builder = G_VARIANT_BUILDER_INIT (G_VARIANT_TYPE ("(issbymsmsia{sv}v)"));
+    g_autoptr(GVariant) outer = NULL;
+    g_autofree guchar *raw = NULL;
+    gsize rlen;
+
+    g_variant_builder_add (&builder, "i", 99);
+    g_variant_builder_add (&builder, "s", "test_sigfm_img");
+    g_variant_builder_add (&builder, "s", "0");
+    g_variant_builder_add (&builder, "b", FALSE);
+    g_variant_builder_add (&builder, "y", FP_FINGER_UNKNOWN);
+    g_variant_builder_add (&builder, "ms", (const gchar *) NULL);
+    g_variant_builder_add (&builder, "ms", (const gchar *) NULL);
+    g_variant_builder_add (&builder, "i", G_MININT32);
+    g_variant_builder_open (&builder, G_VARIANT_TYPE_VARDICT);
+    g_variant_builder_close (&builder);
+    g_variant_builder_add (&builder, "v", g_variant_new_string ("bad"));
+    outer = g_variant_builder_end (&builder);
+
+    rlen = g_variant_get_size (outer) + 3;
+    raw = g_malloc (rlen);
+    raw[0] = 'F';
+    raw[1] = 'P';
+    raw[2] = '3';
+    g_variant_get_data (outer);
+    g_variant_store (outer, raw + 3);
+
+    g_test_expect_message ("libfprint-print", G_LOG_LEVEL_WARNING, "*Invalid print type*");
+    g_assert_null (fp_print_deserialize (raw, rlen, &error));
+    g_test_assert_expected_messages ();
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+    g_clear_error (&error);
+  }
+}

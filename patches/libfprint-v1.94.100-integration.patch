+#if defined(HAVE_SIGFM) && HAVE_SIGFM
+static void
+sigfm_vflip (guint8 *data, gsize width, gsize height)
+{
+  gsize data_len = width * height;
+  g_autofree guint8 *rowbuf = g_malloc (width);
+  gsize i;
+
+  for (i = 0; i < height / 2; i++)
+    {
+      gsize offset = i * width;
+      gsize swap_offset = data_len - (width * (i + 1));
+
+      memcpy (rowbuf, data + offset, width);
+      memcpy (data + offset, data + swap_offset, width);
+      memcpy (data + swap_offset, rowbuf, width);
+    }
+}
+
+static void
+sigfm_hflip (guint8 *data, gsize width, gsize height)
+{
+  g_autofree guint8 *rowbuf = g_malloc (width);
+  gsize i, j;
+
+  for (i = 0; i < height; i++)
+    {
+      gsize offset = i * width;
+
+      memcpy (rowbuf, data + offset, width);
+      for (j = 0; j < width; j++)
+        data[offset + j] = rowbuf[width - j - 1];
+    }
+}
+
+static void
+sigfm_invert_colors (guint8 *data, gsize width, gsize height)
+{
+  gsize data_len = width * height;
+  gsize i;
+
+  for (i = 0; i < data_len; i++)
+    data[i] = 0xff - data[i];
+}
+
+typedef struct
+{
+  SigfmImgInfo  *sigfm_info;
+  FpiImageFlags  flags;
+  unsigned char *image;
+  gboolean       image_changed;
+} ExtractSigfmData;
+
+static void
+fpi_image_extract_sigfm_free (ExtractSigfmData *data)
+{
+  g_clear_pointer (&data->sigfm_info, sigfm_free_info);
+
+  if (data->image_changed)
+    g_clear_pointer (&data->image, g_free);
+
+  g_free (data);
+}
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (ExtractSigfmData, fpi_image_extract_sigfm_free)
+
+static gboolean
+fpi_image_extract_sigfm_finish_data (FpImage *self,
+                                     GTask   *task,
+                                     GError **error)
+{
+  g_autoptr(ExtractSigfmData) data = NULL;
+
+  data = g_task_propagate_pointer (task, error);
+
+  if (data != NULL)
+    {
+      self->flags = data->flags;
+
+      if (data->image_changed)
+        {
+          g_clear_pointer (&self->data, g_free);
+          self->data = g_steal_pointer (&data->image);
+        }
+
+      g_clear_pointer (&self->sigfm_info, sigfm_free_info);
+      self->sigfm_info = g_steal_pointer (&data->sigfm_info);
+
+      return TRUE;
+    }
+
+  return FALSE;
+}
+
+static void
+fpi_image_extract_sigfm_thread_func (GTask        *task,
+                                     gpointer      source_object,
+                                     gpointer      task_data,
+                                     GCancellable *cancellable)
+{
+  g_autoptr(GTimer) timer = NULL;
+  g_autoptr(ExtractSigfmData) ret_data = NULL;
+  g_autoptr(GTask) thread_task = g_steal_pointer (&task);
+  FpImage *self = source_object;
+  FpiImageFlags norm_flags;
+  unsigned char *image;
+  gsize data_len;
+  gint n_keypoints;
+
+  if (!self->data || self->width == 0 || self->height == 0 ||
+      self->width > G_MAXINT || self->height > G_MAXINT ||
+      !g_size_checked_mul (&data_len, (gsize) self->width, (gsize) self->height))
+    {
+      g_task_return_new_error (thread_task, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                               "Cannot extract SIGFM features from empty or invalid image");
+      return;
+    }
+
+  norm_flags = self->flags & (FPI_IMAGE_H_FLIPPED |
+                              FPI_IMAGE_V_FLIPPED |
+                              FPI_IMAGE_COLORS_INVERTED);
+
+  image = self->data;
+  if (norm_flags != FPI_IMAGE_NONE)
+    image = g_memdup2 (self->data, data_len);
+
+  ret_data = g_new0 (ExtractSigfmData, 1);
+  ret_data->flags = self->flags & ~norm_flags;
+  ret_data->image = image;
+  ret_data->image_changed = image != self->data;
+
+  /* Normalize the image first, matching the NBIS path */
+  if (self->flags & FPI_IMAGE_H_FLIPPED)
+    sigfm_hflip (image, self->width, self->height);
+
+  if (self->flags & FPI_IMAGE_V_FLIPPED)
+    sigfm_vflip (image, self->width, self->height);
+
+  if (self->flags & FPI_IMAGE_COLORS_INVERTED)
+    sigfm_invert_colors (image, self->width, self->height);
+
+  if (g_task_return_error_if_cancelled (thread_task))
+    return;
+
+  timer = g_timer_new ();
+  ret_data->sigfm_info = sigfm_extract (image, (int) self->width, (int) self->height);
+  g_timer_stop (timer);
+
+  if (g_task_return_error_if_cancelled (thread_task))
+    return;
+
+  if (!ret_data->sigfm_info)
+    {
+      fp_err ("sigfm_extract failed");
+      g_task_return_new_error (thread_task, G_IO_ERROR, G_IO_ERROR_FAILED,
+                               "SIGFM feature extraction failed");
+      return;
+    }
+
+  n_keypoints = sigfm_keypoints_count (ret_data->sigfm_info);
+  fp_dbg ("SIGFM extraction completed in %f secs (%d keypoints)",
+          g_timer_elapsed (timer, NULL), n_keypoints);
+
+  if (n_keypoints <= 0)
+    {
+      g_task_return_new_error (thread_task, G_IO_ERROR, G_IO_ERROR_FAILED,
+                               "No SIGFM keypoints found");
+      return;
+    }
+
+  g_task_return_pointer (thread_task, g_steal_pointer (&ret_data),
+                         (GDestroyNotify) fpi_image_extract_sigfm_free);
+}
+#endif
+
+/**
+ * fpi_image_get_sigfm_info:
+ * @self: A #FpImage
+ *
+ * Gets the extracted SIGFM feature info for an image.
+ *
+ * Returns: (transfer none) (nullable): The extracted #SigfmImgInfo
+ */
+SigfmImgInfo *
+fpi_image_get_sigfm_info (FpImage *self)
+{
+  g_return_val_if_fail (FP_IS_IMAGE (self), NULL);
+
+  return self->sigfm_info;
+}
+
+/**
+ * fpi_image_extract_sigfm_info:
+ * @self: A #FpImage
+ * @cancellable: a #GCancellable, or %NULL
+ * @callback: the function to call on completion
+ * @user_data: the data to pass to @callback
+ *
+ * Asynchronously normalizes @self and extracts SIGFM features.
+ */
+void
+fpi_image_extract_sigfm_info (FpImage            *self,
+                              GCancellable       *cancellable,
+                              GAsyncReadyCallback callback,
+                              gpointer            user_data)
+{
+  g_autoptr(GTask) task = NULL;
+  gsize data_len;
+
+  g_return_if_fail (FP_IS_IMAGE (self));
+  g_return_if_fail (callback != NULL);
+
+  task = g_task_new (self, cancellable, callback, user_data);
+  g_task_set_source_tag (task, fpi_image_extract_sigfm_info);
+  g_task_set_check_cancellable (task, TRUE);
+
+#if !(defined(HAVE_SIGFM) && HAVE_SIGFM)
+  g_object_set_data (G_OBJECT (task), "fpi-sigfm-skip-unlock", GINT_TO_POINTER (1));
+  g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
+                           "SIGFM support is not compiled in");
+  return;
+#endif
+
+  if (!self->data || self->width == 0 || self->height == 0 ||
+      self->width > G_MAXINT || self->height > G_MAXINT ||
+      !g_size_checked_mul (&data_len, (gsize) self->width, (gsize) self->height))
+    {
+      g_object_set_data (G_OBJECT (task), "fpi-sigfm-skip-unlock", GINT_TO_POINTER (1));
+      g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                               "Cannot extract SIGFM features from empty or invalid image");
+      return;
+    }
+
+  if (!g_atomic_int_compare_and_exchange (&self->detection_in_progress,
+                                          FALSE, TRUE))
+    {
+      g_object_set_data (G_OBJECT (task), "fpi-sigfm-skip-unlock", GINT_TO_POINTER (1));
+      g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_ADDRESS_IN_USE,
+                               "Feature detection is already in progress");
+      return;
+    }
+
+#if defined(HAVE_SIGFM) && HAVE_SIGFM
+  g_task_run_in_thread (g_steal_pointer (&task),
+                        fpi_image_extract_sigfm_thread_func);
+#endif
+}
+
+/**
+ * fpi_image_extract_sigfm_info_finish:
+ * @self: A #FpImage
+ * @result: A #GAsyncResult
+ * @error: Return location for errors, or %NULL to ignore
+ *
+ * Finish SIGFM feature extraction in an image.
+ *
+ * Returns: %TRUE on success
+ */
+gboolean
+fpi_image_extract_sigfm_info_finish (FpImage      *self,
+                                     GAsyncResult *result,
+                                     GError      **error)
+{
+  GTask *task;
+  gboolean changed;
+
+  g_return_val_if_fail (FP_IS_IMAGE (self), FALSE);
+  g_return_val_if_fail (g_task_is_valid (result, self), FALSE);
+  g_return_val_if_fail (g_task_get_source_tag (G_TASK (result)) ==
+                        fpi_image_extract_sigfm_info, FALSE);
+
+  task = G_TASK (result);
+  if (!g_object_get_data (G_OBJECT (task), "fpi-sigfm-skip-unlock"))
+    {
+      changed = g_atomic_int_compare_and_exchange (&self->detection_in_progress,
+                                                   TRUE, FALSE);
+      g_assert (changed);
+    }
+
+  if (g_task_had_error (task))
+    {
+      gpointer data = g_task_propagate_pointer (task, error);
+      g_assert (data == NULL);
+      return FALSE;
+    }
+
+#if defined(HAVE_SIGFM) && HAVE_SIGFM
+  return fpi_image_extract_sigfm_finish_data (self, task, error);
+#else
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
+               "SIGFM support is not compiled in");
+  return FALSE;
+#endif
+}

+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef unsigned char SigfmPix;
+
+/**
+ * @brief Contains information used by the sigfm algorithm for matching
+ * @details Get one from sigfm_extract() and make sure to clean it up with sigfm_free_info()
+ * @struct SigfmImgInfo
+ */
+typedef struct SigfmImgInfo SigfmImgInfo;
+
+/**
+ * @brief Extracts information from an image for later use with sigfm_match_score
+ *
+ * @param pix Pixels of the image, must be width * height bytes in length
+ * @param width Width of the image (> 0)
+ * @param height Height of the image (> 0)
+ * @return SigfmImgInfo* Info that can be used with the API, or NULL on error
+ */
+SigfmImgInfo *sigfm_extract(const SigfmPix *pix, int width, int height);
+
+/**
+ * @brief Destroy a SigfmImgInfo
+ * @warning Call this instead of free() or you will get UB!
+ * @param info SigfmImgInfo to destroy (NULL-safe)
+ */
+void sigfm_free_info(SigfmImgInfo *info);
+
+/**
+ * Experimental matching switches for offline A/B tests. The production
+ * sigfm_match_score() API always uses reciprocal matching and leaves
+ * translation consensus disabled.
+ */
+typedef enum {
+    SIGFM_MATCH_FLAGS_DEFAULT = 0,
+    SIGFM_MATCH_FLAG_FORWARD_ONLY = 1U << 0,
+    SIGFM_MATCH_FLAG_TRANSLATION_CONSENSUS = 1U << 1,
+} SigfmMatchFlags;
+
+/**
+ * @brief Score how closely a frame matches another
+ *
+ * @param frame Print to be checked (probe side)
+ * @param enrolled Canonical print to verify against (template side)
+ * @return int Number of geometrically consistent inliers (>= 0), or < 0 on error
+ *
+ * The score is directional: the forward Lowe-ratio test runs frame ->
+ * enrolled only, while the reverse pass is a plain mutual-nearest-neighbour
+ * check without its own ratio test. Swapping @frame and @enrolled is
+ * therefore not guaranteed to produce the same score. Callers must always
+ * pass the probe as @frame and the enrolled template as @enrolled.
+ */
+int sigfm_match_score(SigfmImgInfo *frame, SigfmImgInfo *enrolled);
+
+/**
+ * @brief A/B-test variant of sigfm_match_score()
+ *
+ * FORWARD_ONLY disables reciprocal matching; TRANSLATION_CONSENSUS adds a
+ * post-RANSAC translation-cluster gate. Unknown flag bits are rejected.
+ * The score is directional (see sigfm_match_score()).
+ */
+int sigfm_match_score_with_flags(SigfmImgInfo *frame, SigfmImgInfo *enrolled,
+                                 unsigned int flags);
+
+/**
+ * @brief Fraction of 8x8 image tiles containing ridge-like contrast
+ *
+ * A two-pixel border is ignored. A tile is active when its grey-level standard
+ * deviation is at least 25. Invalid or too-small inputs return 0.
+ */
+double sigfm_image_coverage(const SigfmPix *pix, int width, int height);
+
+/**
+ * @brief Serialize an image info for storage
+ *
+ * @param info SigfmImgInfo to store
+ * @param outlen output: Length of the returned byte array
+ * @return unsigned char* Byte array for storage (allocated with malloc, caller must free()), or NULL on error
+ */
+unsigned char *sigfm_serialize_binary(SigfmImgInfo *info, int *outlen);
+
+/**
+ * @brief Deserialize a SigfmImgInfo from storage
+ *
+ * @param bytes Byte array to deserialize from
+ * @param len Length of the byte array
+ * @return SigfmImgInfo* Deserialized info, or NULL if deserialization failed
+ */
+SigfmImgInfo *sigfm_deserialize_binary(const unsigned char *bytes, int len);
+
+/**
+ * @brief Keypoints count for an image. Low keypoints generally means the image is
+ * low quality for matching.
+ *
+ * @param info SigfmImgInfo (NULL-safe, returns 0 for NULL)
+ * @return int Number of keypoints
+ */
+int sigfm_keypoints_count(SigfmImgInfo *info);
+
+/**
+ * @brief Copy a SigfmImgInfo
+ *
+ * @param info Source of copy
+ * @return SigfmImgInfo* Newly allocated deep copy of info, or NULL on error/NULL input
+ */
+SigfmImgInfo *sigfm_copy_info(SigfmImgInfo *info);
+
+#ifdef __cplusplus
+}
+#endif

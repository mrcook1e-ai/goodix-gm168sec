+// This library is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+// Lesser General Public License for more details.
+//
+// You should have received a copy of the GNU Lesser General Public
+// License along with this library; if not, write to the Free Software
+// Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+
+#include "sigfm.hpp"
+#include "img-info.hpp"
+
+#include <opencv2/calib3d.hpp>
+#include <opencv2/core.hpp>
+#include <opencv2/features2d.hpp>
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <memory>
+#include <utility>
+#include <vector>
+
+namespace {
+
+static_assert(sizeof(float) == 4 && std::numeric_limits<float>::is_iec559,
+              "IEEE-754 32-bit float is required for SIGFM serialization");
+
+// SIFT parameters tuned for small capacitive sensors (Goodix GM168)
+constexpr int kSiftNFeatures = 0;
+constexpr int kSiftNOctaveLayers = 3;
+constexpr double kSiftContrastThreshold = 0.02;
+constexpr double kSiftEdgeThreshold = 20.0;
+constexpr double kSiftSigma = 1.6;
+
+// Matching & RANSAC verification parameters. The 0.30 inlier ratio is a
+// provisional GM168 retune; synthetic tests do not establish live FAR/FRR.
+constexpr double kLoweRatio = 0.80;
+constexpr std::size_t kMinGoodMatches = 3;
+constexpr double kRansacReprojThreshold = 4.0;
+constexpr std::size_t kRansacMaxIters = 2000;
+constexpr double kRansacConfidence = 0.99;
+constexpr double kMinScale = 0.80;
+constexpr double kMaxScale = 1.25;
+constexpr double kMinInlierRatio = 0.30;
+constexpr double kTranslationConsensusRadius = 4.0;
+
+// Capture quality gate: 8x8 non-overlapping tiles, ignoring a 2 px border.
+constexpr int kCoverageTileSize = 8;
+constexpr int kCoverageBorder = 2;
+constexpr double kCoverageTileMinStdDev = 25.0;
+
+// Versioned binary format constants
+constexpr unsigned char kMagic[4] = {'S', 'G', 'F', 'M'};
+constexpr std::uint32_t kFormatVersion = 1;
+constexpr int kDescCols = 128;
+constexpr std::uint32_t kMaxKeypoints = 16384;
+constexpr std::size_t kHeaderBytes = 12;   // 4 (magic) + 4 (version) + 4 (count)
+constexpr std::size_t kKeypointBytes = 28; // 5 * f32 + 2 * i32
+constexpr std::size_t kDescRowBytes = static_cast<std::size_t>(kDescCols) * 4;
+
+inline void write_u32_le(unsigned char *dst, std::uint32_t v) noexcept
+{
+    dst[0] = static_cast<unsigned char>(v & 0xFFU);
+    dst[1] = static_cast<unsigned char>((v >> 8) & 0xFFU);
+    dst[2] = static_cast<unsigned char>((v >> 16) & 0xFFU);
+    dst[3] = static_cast<unsigned char>((v >> 24) & 0xFFU);
+}
+
+inline std::uint32_t read_u32_le(const unsigned char *src) noexcept
+{
+    return static_cast<std::uint32_t>(src[0]) |
+           (static_cast<std::uint32_t>(src[1]) << 8) |
+           (static_cast<std::uint32_t>(src[2]) << 16) |
+           (static_cast<std::uint32_t>(src[3]) << 24);
+}
+
+inline void write_f32_le(unsigned char *dst, float v) noexcept
+{
+    std::uint32_t bits = 0;
+    std::memcpy(&bits, &v, sizeof(bits));
+    write_u32_le(dst, bits);
+}
+
+inline float read_f32_le(const unsigned char *src) noexcept
+{
+    const std::uint32_t bits = read_u32_le(src);
+    float v = 0.0F;
+    std::memcpy(&v, &bits, sizeof(v));
+    return v;
+}
+
+inline void write_i32_le(unsigned char *dst, std::int32_t v) noexcept
+{
+    std::uint32_t bits = 0;
+    std::memcpy(&bits, &v, sizeof(bits));
+    write_u32_le(dst, bits);
+}
+
+inline std::int32_t read_i32_le(const unsigned char *src) noexcept
+{
+    const std::uint32_t bits = read_u32_le(src);
+    std::int32_t v = 0;
+    std::memcpy(&v, &bits, sizeof(v));
+    return v;
+}
+
+inline bool is_finite_keypoint(const cv::KeyPoint &kp) noexcept
+{
+    return std::isfinite(kp.pt.x) && std::isfinite(kp.pt.y) &&
+           std::isfinite(kp.size) && std::isfinite(kp.angle) &&
+           std::isfinite(kp.response);
+}
+
+} // namespace
+
+SigfmImgInfo *sigfm_copy_info(SigfmImgInfo *info)
+{
+    if (info == nullptr) {
+        return nullptr;
+    }
+    try {
+        return new SigfmImgInfo{info->keypoints, info->descriptors.clone()};
+    }
+    catch (...) {
+        return nullptr;
+    }
+}
+
+int sigfm_keypoints_count(SigfmImgInfo *info)
+{
+    if (info == nullptr) {
+        return 0;
+    }
+    const std::size_t n = info->keypoints.size();
+    if (n > static_cast<std::size_t>(std::numeric_limits<int>::max())) {
+        return std::numeric_limits<int>::max();
+    }
+    return static_cast<int>(n);
+}
+
+unsigned char *sigfm_serialize_binary(SigfmImgInfo *info, int *outlen)
+{
+    if (outlen != nullptr) {
+        *outlen = 0;
+    }
+    if (info == nullptr || outlen == nullptr) {
+        return nullptr;
+    }
+
+    const std::size_t kp_count = info->keypoints.size();
+    if (kp_count > kMaxKeypoints) {
+        return nullptr;
+    }
+
+    if (kp_count == 0) {
+        if (!info->descriptors.empty() && info->descriptors.rows != 0) {
+            return nullptr;
+        }
+    } else {
+        if (info->descriptors.empty() ||
+            info->descriptors.type() != CV_32F ||
+            info->descriptors.cols != kDescCols ||
+            info->descriptors.rows < 0 ||
+            static_cast<std::size_t>(info->descriptors.rows) != kp_count) {
+            return nullptr;
+        }
+    }
+
+    for (std::size_t i = 0; i < kp_count; ++i) {
+        if (!is_finite_keypoint(info->keypoints[i])) {
+            return nullptr;
+        }
+        const float *row = info->descriptors.ptr<float>(static_cast<int>(i));
+        for (int c = 0; c < kDescCols; ++c) {
+            if (!std::isfinite(row[c])) {
+                return nullptr;
+            }
+        }
+    }
+
+    const std::size_t total_len =
+        kHeaderBytes + kp_count * (kKeypointBytes + kDescRowBytes);
+    if (total_len > static_cast<std::size_t>(std::numeric_limits<int>::max())) {
+        return nullptr;
+    }
+
+    auto *buf = static_cast<unsigned char *>(std::malloc(total_len));
+    if (buf == nullptr) {
+        return nullptr;
+    }
+
+    std::memcpy(buf, kMagic, sizeof(kMagic));
+    write_u32_le(buf + 4, kFormatVersion);
+    write_u32_le(buf + 8, static_cast<std::uint32_t>(kp_count));
+
+    unsigned char *cur = buf + kHeaderBytes;
+    for (std::size_t i = 0; i < kp_count; ++i) {
+        const cv::KeyPoint &kp = info->keypoints[i];
+        write_f32_le(cur + 0, kp.pt.x);
+        write_f32_le(cur + 4, kp.pt.y);
+        write_f32_le(cur + 8, kp.size);
+        write_f32_le(cur + 12, kp.angle);
+        write_f32_le(cur + 16, kp.response);
+        write_i32_le(cur + 20, static_cast<std::int32_t>(kp.octave));
+        write_i32_le(cur + 24, static_cast<std::int32_t>(kp.class_id));
+        cur += kKeypointBytes;
+    }
+
+    for (std::size_t i = 0; i < kp_count; ++i) {
+        const float *row = info->descriptors.ptr<float>(static_cast<int>(i));
+        for (int c = 0; c < kDescCols; ++c) {
+            write_f32_le(cur, row[c]);
+            cur += 4;
+        }
+    }
+
+    *outlen = static_cast<int>(total_len);
+    return buf;
+}
+
+SigfmImgInfo *sigfm_deserialize_binary(const unsigned char *bytes, int len)
+{
+    if (bytes == nullptr || len < static_cast<int>(kHeaderBytes)) {
+        return nullptr;
+    }
+
+    const std::size_t ulen = static_cast<std::size_t>(len);
+    if (std::memcmp(bytes, kMagic, sizeof(kMagic)) != 0) {
+        return nullptr;
+    }
+
+    const std::uint32_t version = read_u32_le(bytes + 4);
+    if (version != kFormatVersion) {
+        return nullptr;
+    }
+
+    const std::uint32_t count = read_u32_le(bytes + 8);
+    if (count > kMaxKeypoints) {
+        return nullptr;
+    }
+
+    const std::size_t expected_len =
+        kHeaderBytes + static_cast<std::size_t>(count) * (kKeypointBytes + kDescRowBytes);
+    if (ulen != expected_len) {
+        return nullptr;
+    }
+
+    try {
+        auto info = std::make_unique<SigfmImgInfo>();
+        info->keypoints.reserve(count);
+        if (count > 0) {
+            info->descriptors.create(static_cast<int>(count), kDescCols, CV_32F);
+        }
+
+        const unsigned char *cur = bytes + kHeaderBytes;
+        for (std::uint32_t i = 0; i < count; ++i) {
+            cv::KeyPoint kp;
+            kp.pt.x = read_f32_le(cur + 0);
+            kp.pt.y = read_f32_le(cur + 4);
+            kp.size = read_f32_le(cur + 8);
+            kp.angle = read_f32_le(cur + 12);
+            kp.response = read_f32_le(cur + 16);
+            kp.octave = static_cast<int>(read_i32_le(cur + 20));
+            kp.class_id = static_cast<int>(read_i32_le(cur + 24));
+            if (!is_finite_keypoint(kp)) {
+                return nullptr;
+            }
+            info->keypoints.push_back(kp);
+            cur += kKeypointBytes;
+        }
+
+        for (std::uint32_t i = 0; i < count; ++i) {
+            float *row = info->descriptors.ptr<float>(static_cast<int>(i));
+            for (int c = 0; c < kDescCols; ++c) {
+                const float val = read_f32_le(cur);
+                if (!std::isfinite(val)) {
+                    return nullptr;
+                }
+                row[c] = val;
+                cur += 4;
+            }
+        }
+
+        return info.release();
+    }
+    catch (...) {
+        return nullptr;
+    }
+}
+
+double sigfm_image_coverage(const SigfmPix *pix, int width, int height)
+{
+    if (pix == nullptr || width <= 0 || height <= 0) {
+        return 0.0;
+    }
+
+    int active = 0;
+    int total = 0;
+    for (int ty = kCoverageBorder;
+         ty + kCoverageTileSize <= height - kCoverageBorder;
+         ty += kCoverageTileSize) {
+        for (int tx = kCoverageBorder;
+             tx + kCoverageTileSize <= width - kCoverageBorder;
+             tx += kCoverageTileSize) {
+            std::uint64_t sum = 0;
+            std::uint64_t sum_sq = 0;
+            for (int y = ty; y < ty + kCoverageTileSize; ++y) {
+                for (int x = tx; x < tx + kCoverageTileSize; ++x) {
+                    const std::uint64_t v = pix[static_cast<std::size_t>(y) *
+                                                static_cast<std::size_t>(width) +
+                                                static_cast<std::size_t>(x)];
+                    sum += v;
+                    sum_sq += v * v;
+                }
+            }
+
+            const double n = static_cast<double>(kCoverageTileSize * kCoverageTileSize);
+            const double mean = static_cast<double>(sum) / n;
+            const double variance = static_cast<double>(sum_sq) / n - mean * mean;
+            if (variance >= kCoverageTileMinStdDev * kCoverageTileMinStdDev) {
+                ++active;
+            }
+            ++total;
+        }
+    }
+
+    return total > 0 ? static_cast<double>(active) / static_cast<double>(total) : 0.0;
+}
+
+SigfmImgInfo *sigfm_extract(const SigfmPix *pix, int width, int height)
+{
+    if (pix == nullptr || width <= 0 || height <= 0) {
+        return nullptr;
+    }
+
+    const std::size_t w = static_cast<std::size_t>(width);
+    const std::size_t h = static_cast<std::size_t>(height);
+    if (w > std::numeric_limits<std::size_t>::max() / h) {
+        return nullptr;
+    }
+
+    try {
+        cv::Mat img(height, width, CV_8UC1);
+        std::memcpy(img.data, pix, w * h);
+
+        std::vector<cv::KeyPoint> pts;
+        cv::Mat descs;
+        auto sift = cv::SIFT::create(
+            kSiftNFeatures,
+            kSiftNOctaveLayers,
+            kSiftContrastThreshold,
+            kSiftEdgeThreshold,
+            kSiftSigma);
+        sift->detectAndCompute(img, cv::noArray(), pts, descs);
+
+        auto info = std::make_unique<SigfmImgInfo>();
+        info->keypoints = std::move(pts);
+        info->descriptors = std::move(descs);
+        return info.release();
+    }
+    catch (...) {
+        return nullptr;
+    }
+}
+
+int sigfm_match_score_with_flags(SigfmImgInfo *frame, SigfmImgInfo *enrolled,
+                                 unsigned int flags)
+{
+    if (frame == nullptr || enrolled == nullptr) {
+        return -1;
+    }
+    if ((flags & ~(static_cast<unsigned int>(SIGFM_MATCH_FLAG_FORWARD_ONLY) |
+                   static_cast<unsigned int>(SIGFM_MATCH_FLAG_TRANSLATION_CONSENSUS))) != 0U) {
+        return -1;
+    }
+
+    try {
+        auto is_legitimate_empty = [](const SigfmImgInfo *info) noexcept {
+            return info->keypoints.empty() &&
+                   info->descriptors.empty() &&
+                   info->descriptors.rows == 0;
+        };
+
+        const bool frame_empty = is_legitimate_empty(frame);
+        const bool enrolled_empty = is_legitimate_empty(enrolled);
+
+        if ((!frame_empty &&
+             (frame->descriptors.empty() ||
+              frame->descriptors.type() != CV_32F ||
+              frame->descriptors.cols != kDescCols ||
+              frame->descriptors.rows < 0 ||
+              static_cast<std::size_t>(frame->descriptors.rows) != frame->keypoints.size())) ||
+            (!enrolled_empty &&
+             (enrolled->descriptors.empty() ||
+              enrolled->descriptors.type() != CV_32F ||
+              enrolled->descriptors.cols != kDescCols ||
+              enrolled->descriptors.rows < 0 ||
+              static_cast<std::size_t>(enrolled->descriptors.rows) != enrolled->keypoints.size()))) {
+            return -1;
+        }
+
+        // Fail closed on non-finite features. knnMatch() and
+        // estimateAffinePartial2D() handle NaN/Inf inputs in an
+        // OpenCV-version-specific way, so every keypoint field and descriptor
+        // value must be validated here before any matching happens. This runs
+        // before the small-set early return below on purpose: a single NaN in
+        // a one-row set is an error, not a zero-score non-match. Legitimate
+        // empty sets skip the loop and keep their score of 0.
+        for (const SigfmImgInfo *info : {frame, enrolled}) {
+            if (is_legitimate_empty(info)) {
+                continue;
+            }
+            for (const cv::KeyPoint &kp : info->keypoints) {
+                if (!is_finite_keypoint(kp)) {
+                    return -1;
+                }
+            }
+            for (int r = 0; r < info->descriptors.rows; ++r) {
+                const float *row = info->descriptors.ptr<float>(r);
+                for (int c = 0; c < info->descriptors.cols; ++c) {
+                    if (!std::isfinite(row[c])) {
+                        return -1;
+                    }
+                }
+            }
+        }
+
+        if (frame_empty || enrolled_empty ||
+            frame->descriptors.rows < 2 || enrolled->descriptors.rows < 2) {
+            return 0;
+        }
+
+        auto bfm = cv::BFMatcher::create(cv::NORM_L2);
+        std::vector<std::vector<cv::DMatch>> forward;
+        std::vector<std::vector<cv::DMatch>> backward;
+        bfm->knnMatch(frame->descriptors, enrolled->descriptors, forward, 2);
+        if ((flags & static_cast<unsigned int>(SIGFM_MATCH_FLAG_FORWARD_ONLY)) == 0U) {
+            bfm->knnMatch(enrolled->descriptors, frame->descriptors, backward, 1);
+        }
+
+        std::vector<cv::Point2f> pts1;
+        std::vector<cv::Point2f> pts2;
+        pts1.reserve(forward.size());
+        pts2.reserve(forward.size());
+
+        for (const auto &pair : forward) {
+            if (pair.size() != 2 ||
+                static_cast<double>(pair[0].distance) >=
+                    kLoweRatio * static_cast<double>(pair[1].distance)) {
+                continue;
+            }
+
+            const int q = pair[0].queryIdx;
+            const int t = pair[0].trainIdx;
+            if (q < 0 || static_cast<std::size_t>(q) >= frame->keypoints.size() ||
+                t < 0 || static_cast<std::size_t>(t) >= enrolled->keypoints.size()) {
+                continue;
+            }
+
+            // Mutual nearest neighbours remove ambiguous many-to-one matches.
+            if ((flags & static_cast<unsigned int>(SIGFM_MATCH_FLAG_FORWARD_ONLY)) == 0U &&
+                (backward.size() <= static_cast<std::size_t>(t) ||
+                 backward[static_cast<std::size_t>(t)].size() != 1 ||
+                 backward[static_cast<std::size_t>(t)][0].queryIdx != t ||
+                 backward[static_cast<std::size_t>(t)][0].trainIdx != q)) {
+                continue;
+            }
+
+            pts1.push_back(frame->keypoints[static_cast<std::size_t>(q)].pt);
+            pts2.push_back(enrolled->keypoints[static_cast<std::size_t>(t)].pt);
+        }
+
+        const std::size_t good_count = pts1.size();
+        if (good_count < kMinGoodMatches) {
+            return 0;
+        }
+
+        cv::Mat inl_mask;
+        cv::Mat model = cv::estimateAffinePartial2D(
+            pts1,
+            pts2,
+            inl_mask,
+            cv::RANSAC,
+            kRansacReprojThreshold,
+            kRansacMaxIters,
+            kRansacConfidence);
+
+        if (model.empty() || model.rows != 2 || model.cols != 3 ||
+            model.type() != CV_64FC1 || inl_mask.empty()) {
+            return 0;
+        }
+
+        const double a00 = model.at<double>(0, 0);
+        const double a01 = model.at<double>(0, 1);
+        const double a10 = model.at<double>(1, 0);
+        const double a11 = model.at<double>(1, 1);
+        const double scale = std::hypot(a00, a01);
+        if (!std::isfinite(scale) || scale < kMinScale || scale > kMaxScale ||
+            !std::isfinite(a10) || !std::isfinite(a11) ||
+            !std::isfinite(model.at<double>(0, 2)) ||
+            !std::isfinite(model.at<double>(1, 2))) {
+            return 0;
+        }
+
+        int inliers = cv::countNonZero(inl_mask);
+        const double inlier_ratio =
+            static_cast<double>(inliers) / static_cast<double>(good_count);
+        if (inlier_ratio < kMinInlierRatio) {
+            return 0;
+        }
+
+        if ((flags & static_cast<unsigned int>(SIGFM_MATCH_FLAG_TRANSLATION_CONSENSUS)) != 0U) {
+            std::vector<cv::Point2f> translations;
+            translations.reserve(static_cast<std::size_t>(inliers));
+            for (std::size_t i = 0; i < good_count; ++i) {
+                if (inl_mask.at<unsigned char>(static_cast<int>(i)) == 0U) {
+                    continue;
+                }
+                const double projected_x = a00 * pts1[i].x + a01 * pts1[i].y;
+                const double projected_y = a10 * pts1[i].x + a11 * pts1[i].y;
+                translations.emplace_back(
+                    static_cast<float>(pts2[i].x - projected_x),
+                    static_cast<float>(pts2[i].y - projected_y));
+            }
+
+            int consensus = 0;
+            for (const auto &candidate : translations) {
+                int support = 0;
+                for (const auto &other : translations) {
+                    if (std::hypot(candidate.x - other.x, candidate.y - other.y) <=
+                        kTranslationConsensusRadius) {
+                        ++support;
+                    }
+                }
+                consensus = std::max(consensus, support);
+            }
+
+            const double consensus_ratio =
+                static_cast<double>(consensus) / static_cast<double>(good_count);
+            if (consensus_ratio < kMinInlierRatio) {
+                return 0;
+            }
+            inliers = consensus;
+        }
+
+        return inliers;
+    }
+    catch (...) {
+        return -1;
+    }
+}
+
+int sigfm_match_score(SigfmImgInfo *frame, SigfmImgInfo *enrolled)
+{
+    return sigfm_match_score_with_flags(frame, enrolled, SIGFM_MATCH_FLAGS_DEFAULT);
+}
+
+void sigfm_free_info(SigfmImgInfo *info)
+{
+    delete info;
+}

+  {
+    SigfmImgInfo *info = fpi_image_get_sigfm_info (image);
+    gint keypoints = sigfm_keypoints_count (info);
+    gdouble coverage = fpi_image_get_sigfm_coverage (image);
+
+    fp_dbg ("SIGFM quality: keypoints=%d/%d coverage=%.3f/%.3f",
+            keypoints, priv->sigfm_min_keypoints,
+            coverage, priv->sigfm_min_coverage);
+
+    if (keypoints < priv->sigfm_min_keypoints)
+      {
+        g_set_error (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_CENTER_FINGER,
+                     "Too little fingerprint detail, please place your finger over the sensor");
+        return FALSE;
+      }
+
+    if (require_coverage && coverage < priv->sigfm_min_coverage)
+      {
+        g_set_error (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_CENTER_FINGER,
+                     "Partial fingerprint coverage, please center your finger on the sensor");
+        return FALSE;
+      }
+  }
+#endif
+
+  return TRUE;
+}

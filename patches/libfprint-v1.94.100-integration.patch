+/* SIGFM verify/identify auto-retry on no-match (NBIS & other drivers stay at 0).
+ * Allowing N retries (e.g. N=2 -> up to 3 touches per session) also gives an
+ * impostor multiple attempts. GM168 match thresholds and retry budgets are
+ * provisional per-driver policy; no population FAR claim is implied. */
+void
+fpi_image_device_apply_sigfm_verify_retry (FpImageDevice  *self,
+                                           FpPrint        *result,
+                                           FpPrint       **print,
+                                           GError        **error)
+{
+  FpImageDevicePrivate *priv = fp_image_device_get_instance_private (self);
+
+  g_return_if_fail (FP_IS_IMAGE_DEVICE (self));
+  g_return_if_fail (error != NULL);
+
+  if (priv->algorithm != FPI_PRINT_SIGFM)
+    return;
+
+  if (!*error && result == NULL &&
+      priv->sigfm_verify_retries > 0 &&
+      priv->verify_retry_count < priv->sigfm_verify_retries)
+    {
+      priv->verify_retry_count += 1;
+      priv->verify_retry_pending = TRUE;
+      fp_dbg ("SIGFM verify no-match: requesting retry (%d/%d)",
+              priv->verify_retry_count, priv->sigfm_verify_retries);
+      if (print)
+        g_clear_object (print);
+      *error = fpi_device_retry_new_msg (FP_DEVICE_RETRY_GENERAL,
+                                         "Fingerprint did not match, please try again");
+    }
+  else if (*error && (*error)->domain == FP_DEVICE_RETRY)
+    {
+      priv->verify_retry_pending = (priv->verify_retry_count > 0);
+    }
+  else
+    {
+      priv->verify_retry_count = 0;
+      priv->verify_retry_pending = FALSE;
+    }

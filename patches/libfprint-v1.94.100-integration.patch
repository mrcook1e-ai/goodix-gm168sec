+// License along with this library; if not, write to the Free Software
+// Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+
+#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
+#include <doctest/doctest.h>
+
+#include "img-info.hpp"
+#include "sigfm.hpp"
+
+#include <opencv2/core.hpp>
+#include <opencv2/imgproc.hpp>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <memory>
+#include <vector>
+
+namespace {
+
+struct SigfmDeleter {
+    void operator()(SigfmImgInfo *p) const noexcept { sigfm_free_info(p); }
+};
+using SigfmPtr = std::unique_ptr<SigfmImgInfo, SigfmDeleter>;
+
+struct MallocDeleter {
+    void operator()(unsigned char *p) const noexcept { std::free(p); }
+};
+using BytesPtr = std::unique_ptr<unsigned char, MallocDeleter>;
+
+cv::Mat make_synthetic_pattern(int width, int height, std::uint32_t seed)
+{
+    cv::Mat img(height, width, CV_8UC1, cv::Scalar(128));
+    std::uint64_t state = seed ? seed : 1ULL;
+    auto next_u32 = [&state]() -> std::uint32_t {
+        state = state * 6364136223846793005ULL + 1442695040888963407ULL;
+        return static_cast<std::uint32_t>(state >> 32);
+    };
+
+    // High-contrast synthetic geometric blobs, rings, and ridges (non-biometric)
+    for (int y = 0; y < height; ++y) {
+        auto *row = img.ptr<unsigned char>(y);
+        for (int x = 0; x < width; ++x) {
+            const double fx = static_cast<double>(x);
+            const double fy = static_cast<double>(y);
+            const double phase = static_cast<double>(seed & 0xFFU) * 0.1;
+            const double wave =
+                std::sin(fx * 0.35 + fy * 0.18 + phase) * 35.0 +
+                std::cos(fx * 0.14 - fy * 0.39 + phase * 0.5) * 30.0;
+            const int v = std::clamp(static_cast<int>(128.0 + wave), 0, 255);
+            row[x] = static_cast<unsigned char>(v);
+        }
+    }
+
+    for (int i = 0; i < 45; ++i) {
+        const int cx = 12 + static_cast<int>(next_u32() % static_cast<std::uint32_t>(width - 24));
+        const int cy = 12 + static_cast<int>(next_u32() % static_cast<std::uint32_t>(height - 24));
+        const int r = 2 + static_cast<int>(next_u32() % 6U);
+        const int val = (next_u32() & 1U) ? 245 : 10;
+        cv::circle(img, cv::Point(cx, cy), r, cv::Scalar(val), -1, cv::LINE_AA);
+        if ((i % 3) == 0) {
+            const int dx = static_cast<int>(next_u32() % 15U) - 7;
+            const int dy = static_cast<int>(next_u32() % 15U) - 7;
+            cv::line(img, cv::Point(cx, cy), cv::Point(cx + dx, cy + dy),
+                     cv::Scalar(255 - val), 1, cv::LINE_AA);
+        }
+    }
+    return img;
+}
+
+SigfmPtr make_synthetic_features(const std::vector<cv::Point2f> &pts, int desc_offset = 0)
+{
+    auto info = SigfmPtr(new SigfmImgInfo());
+    const int n = static_cast<int>(pts.size());
+    info->keypoints.reserve(pts.size());
+    info->descriptors = cv::Mat::zeros(n, 128, CV_32F);
+    for (int i = 0; i < n; ++i) {
+        cv::KeyPoint kp;
+        kp.pt = pts[static_cast<std::size_t>(i)];
+        kp.size = 4.0F;
+        kp.angle = 30.0F;
+        kp.response = 0.05F;
+        kp.octave = 0;
+        kp.class_id = -1;
+        info->keypoints.push_back(kp);
+
+        // Orthogonal unit-norm descriptors with unique dominant bin per index
+        const int bin = (i + desc_offset) % 128;
+        info->descriptors.at<float>(i, bin) = 1.0F;
+        info->descriptors.at<float>(i, (bin + 17) % 128) = 0.25F;
+    }
+    return info;
+}
+
+std::vector<cv::Point2f> transform_pts(const std::vector<cv::Point2f> &in, double scale,
+                                       double angle_deg, float tx, float ty)
+{
+    const double rad = angle_deg * (3.14159265358979323846 / 180.0);
+    const double c = std::cos(rad) * scale;
+    const double s = std::sin(rad) * scale;
+    std::vector<cv::Point2f> out;
+    out.reserve(in.size());
+    for (const auto &p : in) {
+        out.emplace_back(static_cast<float>(c * p.x - s * p.y + tx),
+                         static_cast<float>(s * p.x + c * p.y + ty));
+    }
+    return out;
+}
+
+void write_u32_le_test(unsigned char *dst, std::uint32_t v)
+{
+    dst[0] = static_cast<unsigned char>(v & 0xFFU);
+    dst[1] = static_cast<unsigned char>((v >> 8) & 0xFFU);
+    dst[2] = static_cast<unsigned char>((v >> 16) & 0xFFU);
+    dst[3] = static_cast<unsigned char>((v >> 24) & 0xFFU);
+}
+
+} // namespace
+
+TEST_SUITE("sigfm")
+{
+    TEST_CASE("null, invalid, and empty image handling")
+    {
+        CHECK(sigfm_extract(nullptr, 80, 64) == nullptr);
+        unsigned char dummy[16] = {};
+        CHECK(sigfm_extract(dummy, 0, 64) == nullptr);
+        CHECK(sigfm_extract(dummy, 80, 0) == nullptr);
+        CHECK(sigfm_extract(dummy, -10, 10) == nullptr);
+
+        sigfm_free_info(nullptr);
+        CHECK(sigfm_copy_info(nullptr) == nullptr);
+        CHECK(sigfm_keypoints_count(nullptr) == 0);
+        CHECK(sigfm_match_score(nullptr, nullptr) < 0);
+
+        cv::Mat blank(128, 128, CV_8UC1, cv::Scalar(128));
+        SigfmPtr blank_info(sigfm_extract(blank.data, blank.cols, blank.rows));
+        REQUIRE(blank_info != nullptr);
+        CHECK(sigfm_keypoints_count(blank_info.get()) == 0);
+        CHECK(sigfm_match_score(blank_info.get(), blank_info.get()) == 0);
+        CHECK(sigfm_match_score(blank_info.get(), nullptr) < 0);
+
+        // Empty-feature round-trip serialization (header only = 12 bytes)
+        int slen = -1;
+        BytesPtr serialized(sigfm_serialize_binary(blank_info.get(), &slen));
+        REQUIRE(serialized != nullptr);
+        CHECK(slen == 12);
+
+        SigfmPtr restored(sigfm_deserialize_binary(serialized.get(), slen));
+        REQUIRE(restored != nullptr);
+        CHECK(sigfm_keypoints_count(restored.get()) == 0);
+        CHECK(sigfm_match_score(restored.get(), blank_info.get()) == 0);
+
+        // Single valid keypoint (< 2 rows) returns 0
+        SigfmPtr single_kp = make_synthetic_features({{10.0F, 10.0F}});
+        CHECK(sigfm_match_score(single_kp.get(), single_kp.get()) == 0);
+        CHECK(sigfm_match_score(single_kp.get(), blank_info.get()) == 0);
+
+        // Mismatched / malformed SigfmImgInfo must return -1 (not 0)
+        SigfmImgInfo empty_desc_with_kp;
+        empty_desc_with_kp.keypoints.emplace_back(10.0F, 10.0F, 4.0F);
+        CHECK(sigfm_match_score(&empty_desc_with_kp, single_kp.get()) == -1);
+        CHECK(sigfm_match_score(blank_info.get(), &empty_desc_with_kp) == -1);
+
+        SigfmImgInfo single_row_wrong_type;
+        single_row_wrong_type.keypoints.emplace_back(10.0F, 10.0F, 4.0F);
+        single_row_wrong_type.descriptors = cv::Mat::zeros(1, 128, CV_8U);
+        CHECK(sigfm_match_score(&single_row_wrong_type, single_kp.get()) == -1);
+
+        SigfmImgInfo wrong_cols;
+        wrong_cols.keypoints.emplace_back(10.0F, 10.0F, 4.0F);
+        wrong_cols.descriptors = cv::Mat::zeros(1, 64, CV_32F);
+        CHECK(sigfm_match_score(&wrong_cols, single_kp.get()) == -1);
+
+        SigfmImgInfo kp_desc_mismatch;
+        kp_desc_mismatch.keypoints.emplace_back(10.0F, 10.0F, 4.0F);
+        kp_desc_mismatch.keypoints.emplace_back(20.0F, 20.0F, 4.0F);
+        kp_desc_mismatch.descriptors = cv::Mat::zeros(1, 128, CV_32F);
+        CHECK(sigfm_match_score(&kp_desc_mismatch, single_kp.get()) == -1);
+    }
+
+    TEST_CASE("non-finite keypoints and descriptors are rejected")
+    {
+        const std::vector<cv::Point2f> pts = {
+            {15.0F, 15.0F}, {45.0F, 20.0F}, {90.0F, 18.0F}, {130.0F, 25.0F},
+            {25.0F, 60.0F}, {75.0F, 55.0F}, {120.0F, 65.0F}, {20.0F, 105.0F},
+            {80.0F, 100.0F}, {135.0F, 110.0F},
+        };
+        SigfmPtr valid = make_synthetic_features(pts);
+
+        const float qnan = std::numeric_limits<float>::quiet_NaN();
+        const float pinf = std::numeric_limits<float>::infinity();
+
+        // NaN / Inf in keypoint fields (pt and size/angle/response alike)
+        SigfmPtr nan_pt = make_synthetic_features(pts);
+        nan_pt->keypoints[3].pt.x = qnan;
+        CHECK(sigfm_match_score(nan_pt.get(), valid.get()) < 0);
+        CHECK(sigfm_match_score(valid.get(), nan_pt.get()) < 0);
+
+        SigfmPtr inf_pt = make_synthetic_features(pts);
+        inf_pt->keypoints[3].pt.y = pinf;
+        CHECK(sigfm_match_score(inf_pt.get(), valid.get()) < 0);
+
+        SigfmPtr nan_size = make_synthetic_features(pts);
+        nan_size->keypoints[3].size = qnan;
+        CHECK(sigfm_match_score(nan_size.get(), valid.get()) < 0);
+
+        // NaN / Inf descriptor values
+        SigfmPtr nan_desc = make_synthetic_features(pts);
+        nan_desc->descriptors.at<float>(2, 7) = qnan;
+        CHECK(sigfm_match_score(nan_desc.get(), valid.get()) < 0);
+        CHECK(sigfm_match_score(valid.get(), nan_desc.get()) < 0);
+
+        SigfmPtr inf_desc = make_synthetic_features(pts);
+        inf_desc->descriptors.at<float>(2, 7) = -pinf;
+        CHECK(sigfm_match_score(inf_desc.get(), valid.get()) < 0);
+
+        // Non-finite data in a minimal one-row set is an error, not a
+        // zero-score non-match: the validation runs before the rows < 2 gate.
+        SigfmPtr single_kp = make_synthetic_features({{10.0F, 10.0F}});
+        single_kp->descriptors.at<float>(0, 0) = qnan;
+        CHECK(sigfm_match_score(single_kp.get(), single_kp.get()) < 0);
+
+        // Legitimate empty sets keep their score of 0.
+        SigfmPtr empty(new SigfmImgInfo());
+        CHECK(sigfm_match_score(empty.get(), valid.get()) == 0);
+        CHECK(sigfm_match_score(valid.get(), empty.get()) == 0);
+    }
+
+    TEST_CASE("serialization round-trip and copy isolation")
+    {
+        cv::Mat pat = make_synthetic_pattern(160, 128, 1337);
+        SigfmPtr info(sigfm_extract(pat.data, pat.cols, pat.rows));
+        REQUIRE(info != nullptr);
+        const int kp_count = sigfm_keypoints_count(info.get());
+        REQUIRE(kp_count >= 25);
+
+        int slen1 = 0;
+        BytesPtr bin1(sigfm_serialize_binary(info.get(), &slen1));
+        REQUIRE(bin1 != nullptr);
+        CHECK(slen1 == 12 + kp_count * (28 + 128 * 4));
+        CHECK(std::memcmp(bin1.get(), "SGFM", 4) == 0);
+
+        SigfmPtr info2(sigfm_deserialize_binary(bin1.get(), slen1));
+        REQUIRE(info2 != nullptr);
+        CHECK(sigfm_keypoints_count(info2.get()) == kp_count);
+
+        int slen2 = 0;
+        BytesPtr bin2(sigfm_serialize_binary(info2.get(), &slen2));
+        REQUIRE(bin2 != nullptr);
+        REQUIRE(slen2 == slen1);
+        CHECK(std::memcmp(bin1.get(), bin2.get(), static_cast<std::size_t>(slen1)) == 0);
+
+        // Copy remains valid after destroying original
+        SigfmPtr copy(sigfm_copy_info(info.get()));
+        REQUIRE(copy != nullptr);
+        info.reset();
+        int slen3 = 0;
+        BytesPtr bin3(sigfm_serialize_binary(copy.get(), &slen3));
+        REQUIRE(bin3 != nullptr);
+        REQUIRE(slen3 == slen1);
+        CHECK(std::memcmp(bin1.get(), bin3.get(), static_cast<std::size_t>(slen1)) == 0);
+    }
+
+    TEST_CASE("corrupt, truncated, trailing, and huge-count rejection")
+    {
+        CHECK(sigfm_deserialize_binary(nullptr, 12) == nullptr);
+        unsigned char short_buf[11] = {};
+        CHECK(sigfm_deserialize_binary(short_buf, 11) == nullptr);
+        CHECK(sigfm_deserialize_binary(short_buf, -5) == nullptr);
+
+        int outlen = 123;
+        CHECK(sigfm_serialize_binary(nullptr, &outlen) == nullptr);
+        CHECK(outlen == 0);
+
+        cv::Mat pat = make_synthetic_pattern(160, 128, 42);
+        SigfmPtr info(sigfm_extract(pat.data, pat.cols, pat.rows));
+        REQUIRE(info != nullptr);
+        REQUIRE(sigfm_keypoints_count(info.get()) > 0);
+
+        int slen = 0;
+        BytesPtr bin(sigfm_serialize_binary(info.get(), &slen));
+        REQUIRE(bin != nullptr);
+        REQUIRE(slen > 12);
+
+        // Truncated
+        CHECK(sigfm_deserialize_binary(bin.get(), slen - 1) == nullptr);
+        CHECK(sigfm_deserialize_binary(bin.get(), 12) == nullptr);
+
+        // Trailing garbage
+        std::vector<unsigned char> padded(static_cast<std::size_t>(slen) + 1, 0);
+        std::memcpy(padded.data(), bin.get(), static_cast<std::size_t>(slen));
+        CHECK(sigfm_deserialize_binary(padded.data(), slen + 1) == nullptr);
+
+        // Bad magic
+        std::vector<unsigned char> bad_magic(bin.get(), bin.get() + slen);
+        bad_magic[0] = 'X';
+        CHECK(sigfm_deserialize_binary(bad_magic.data(), slen) == nullptr);
+
+        // Bad version
+        std::vector<unsigned char> bad_ver(bin.get(), bin.get() + slen);
+        write_u32_le_test(bad_ver.data() + 4, 99);
+        CHECK(sigfm_deserialize_binary(bad_ver.data(), slen) == nullptr);
+
+        // Huge count (must fail immediately without allocating)
+        std::vector<unsigned char> huge(12, 0);
+        std::memcpy(huge.data(), "SGFM", 4);
+        write_u32_le_test(huge.data() + 4, 1);
+        write_u32_le_test(huge.data() + 8, 0x7FFFFFFFU);
+        CHECK(sigfm_deserialize_binary(huge.data(), 12) == nullptr);
+
+        // Non-finite float in keypoint coordinate
+        std::vector<unsigned char> nan_kp(bin.get(), bin.get() + slen);
+        const float qnan = std::numeric_limits<float>::quiet_NaN();
+        std::uint32_t nan_bits = 0;
+        std::memcpy(&nan_bits, &qnan, sizeof(nan_bits));
+        write_u32_le_test(nan_kp.data() + 12, nan_bits);
+        CHECK(sigfm_deserialize_binary(nan_kp.data(), slen) == nullptr);
+
+        // Non-finite float in descriptor
+        std::vector<unsigned char> inf_desc(bin.get(), bin.get() + slen);
+        const float pinf = std::numeric_limits<float>::infinity();
+        std::uint32_t inf_bits = 0;
+        std::memcpy(&inf_bits, &pinf, sizeof(inf_bits));
+        write_u32_le_test(inf_desc.data() + static_cast<std::size_t>(slen) - 4, inf_bits);
+        CHECK(sigfm_deserialize_binary(inf_desc.data(), slen) == nullptr);
+    }
+
+    TEST_CASE("serialize rejects keypoint counts above the SGFM v1 limit")
+    {
+        // kMaxKeypoints + 1: must fail immediately without allocating.
+        SigfmImgInfo too_many;
+        too_many.descriptors = cv::Mat::zeros(16385, 128, CV_32F);
+        for (int i = 0; i < 16385; ++i) {
+            cv::KeyPoint kp;
+            kp.pt = {1.0F, 1.0F};
+            kp.size = 4.0F;
+            kp.angle = 30.0F;
+            kp.response = 0.05F;
+            kp.octave = 0;
+            kp.class_id = -1;
+            too_many.keypoints.push_back(kp);
+        }
+        int outlen = 123;
+        CHECK(sigfm_serialize_binary(&too_many, &outlen) == nullptr);
+        CHECK(outlen == 0);
+
+        // NULL outlen is an error and must not crash on a valid info.
+        cv::Mat pat = make_synthetic_pattern(64, 64, 7);
+        SigfmPtr info(sigfm_extract(pat.data, pat.cols, pat.rows));
+        REQUIRE(info != nullptr);
+        CHECK(sigfm_serialize_binary(info.get(), nullptr) == nullptr);
+    }
+
+    TEST_CASE("genuine transformed pattern vs different synthetic pattern")
+    {
+        cv::Mat img_a = make_synthetic_pattern(160, 128, 2026);
+        cv::Mat img_c = make_synthetic_pattern(160, 128, 99991);
+
+        // Apply a genuine similarity transform: +10 deg, scale 1.05, shift (+6, -4)
+        cv::Mat rot = cv::getRotationMatrix2D(cv::Point2f(80.0F, 64.0F), 10.0, 1.05);
+        rot.at<double>(0, 2) += 6.0;
+        rot.at<double>(1, 2) -= 4.0;
+        cv::Mat img_b;
+        cv::warpAffine(img_a, img_b, rot, img_a.size(), cv::INTER_LINEAR, cv::BORDER_REFLECT_101);
+
+        SigfmPtr info_a(sigfm_extract(img_a.data, img_a.cols, img_a.rows));
+        SigfmPtr info_b(sigfm_extract(img_b.data, img_b.cols, img_b.rows));
+        SigfmPtr info_c(sigfm_extract(img_c.data, img_c.cols, img_c.rows));
+        REQUIRE(info_a != nullptr);
+        REQUIRE(info_b != nullptr);
+        REQUIRE(info_c != nullptr);
+
+        CHECK(sigfm_keypoints_count(info_a.get()) >= 25);
+        CHECK(sigfm_keypoints_count(info_b.get()) >= 25);
+        CHECK(sigfm_keypoints_count(info_c.get()) >= 25);
+
+        cv::setRNGSeed(42);
+        const int genuine_score = sigfm_match_score(info_a.get(), info_b.get());
+        cv::setRNGSeed(42);
+        const int impostor_score = sigfm_match_score(info_a.get(), info_c.get());
+
+        CHECK(genuine_score >= 10);
+        CHECK(impostor_score <= 5);
+        CHECK(genuine_score > impostor_score);
+    }
+
+    TEST_CASE("RANSAC scale bounds and inlier_ratio guards")
+    {
+        // 10 well-spread 2D points
+        const std::vector<cv::Point2f> base_pts = {
+            {15.0F, 15.0F}, {45.0F, 20.0F}, {90.0F, 18.0F}, {130.0F, 25.0F}, {25.0F, 60.0F},
+            {75.0F, 55.0F}, {120.0F, 65.0F}, {20.0F, 105.0F}, {80.0F, 100.0F}, {135.0F, 110.0F},
+        };
+        SigfmPtr ref = make_synthetic_features(base_pts);
+
+        // Valid scale (1.10) + rotation + translation -> all 10 inliers
+        SigfmPtr valid = make_synthetic_features(transform_pts(base_pts, 1.10, 15.0, 12.0F, -8.0F));
+        cv::setRNGSeed(42);
+        CHECK(sigfm_match_score(ref.get(), valid.get()) == 10);
+
+        // Scale above 1.25 (1.50) -> rejected (0)
+        SigfmPtr too_big = make_synthetic_features(transform_pts(base_pts, 1.50, 15.0, 12.0F, -8.0F));
+        cv::setRNGSeed(42);
+        CHECK(sigfm_match_score(ref.get(), too_big.get()) == 0);
+
+        // Scale below 0.80 (0.65) -> rejected (0)
+        SigfmPtr too_small = make_synthetic_features(transform_pts(base_pts, 0.65, 15.0, 12.0F, -8.0F));
+        cv::setRNGSeed(42);
+        CHECK(sigfm_match_score(ref.get(), too_small.get()) == 0);
+
+        // Low inlier_ratio (< 0.30): 4 consistent + 10 scrambled = 14 good
+        // matches, ratio = 4/14 = 0.286 -> 0
+        std::vector<cv::Point2f> pts14(base_pts.begin(), base_pts.begin() + 4);
+        pts14.emplace_back(50.0F, 85.0F);
+        pts14.emplace_back(105.0F, 40.0F);
+        pts14.emplace_back(30.0F, 30.0F);
+        pts14.emplace_back(95.0F, 90.0F);
+        pts14.emplace_back(60.0F, 15.0F);
+        pts14.emplace_back(15.0F, 80.0F);
+        pts14.emplace_back(110.0F, 55.0F);
+        pts14.emplace_back(70.0F, 40.0F);
+        pts14.emplace_back(40.0F, 95.0F);
+        pts14.emplace_back(125.0F, 80.0F);
+        std::vector<cv::Point2f> pts14_low_ratio = transform_pts(pts14, 1.0, 5.0, 4.0F, 3.0F);
+        // Scramble the 10 extra points with large non-affine offsets (> 25 px)
+        const std::vector<cv::Point2f> offsets = {
+            {40.0F, -30.0F}, {-35.0F, 45.0F}, {55.0F, 30.0F}, {-40.0F, -35.0F},
+            {28.0F, 50.0F}, {-50.0F, 15.0F}, {35.0F, -45.0F}, {-25.0F, 40.0F},
+            {45.0F, 20.0F}, {-30.0F, -50.0F},
+        };
+        for (std::size_t i = 4; i < 14; ++i) {
+            pts14_low_ratio[i].x += offsets[i - 4].x;
+            pts14_low_ratio[i].y += offsets[i - 4].y;
+        }
+        SigfmPtr f_src14 = make_synthetic_features(pts14);
+        SigfmPtr f_low = make_synthetic_features(pts14_low_ratio);
+        cv::setRNGSeed(42);
+        CHECK(sigfm_match_score(f_src14.get(), f_low.get()) == 0);
+
+        // Exact boundary (ratio == 0.30): 3 consistent + 7 scrambled = 10 good
+        // matches, ratio = 3/10 = 0.30. The gate is inclusive, so this passes
+        // and scores exactly the 3 consistent inliers.
+        std::vector<cv::Point2f> pts10 = base_pts;
+        pts10.resize(3);
+        pts10.emplace_back(50.0F, 85.0F);
+        pts10.emplace_back(105.0F, 40.0F);
+        pts10.emplace_back(30.0F, 30.0F);
+        pts10.emplace_back(95.0F, 90.0F);
+        pts10.emplace_back(60.0F, 15.0F);
+        pts10.emplace_back(15.0F, 80.0F);
+        pts10.emplace_back(110.0F, 55.0F);
+        std::vector<cv::Point2f> pts10_boundary = transform_pts(pts10, 1.0, 5.0, 4.0F, 3.0F);
+        for (std::size_t i = 3; i < 10; ++i) {
+            pts10_boundary[i].x += offsets[i - 3].x;
+            pts10_boundary[i].y += offsets[i - 3].y;
+        }
+        SigfmPtr f_src10 = make_synthetic_features(pts10);
+        SigfmPtr f_boundary = make_synthetic_features(pts10_boundary);
+        cv::setRNGSeed(42);
+        CHECK(sigfm_match_score(f_src10.get(), f_boundary.get()) == 3);
+
+        // Boundary pass (ratio >= 0.30): 5 consistent + 5 scrambled = 10 good matches, ratio = 0.50 -> 5
+        std::vector<cv::Point2f> pts10_half = transform_pts(base_pts, 1.0, 5.0, 4.0F, 3.0F);
+        for (std::size_t i = 5; i < 10; ++i) {
+            pts10_half[i].x += offsets[i - 5].x;
+            pts10_half[i].y += offsets[i - 5].y;
+        }
+        SigfmPtr f_half = make_synthetic_features(pts10_half);
+        cv::setRNGSeed(42);
+        CHECK(sigfm_match_score(ref.get(), f_half.get()) == 5);
+    }
+
+    TEST_CASE("RANSAC scale boundaries are inclusive")
+    {
+        const std::vector<cv::Point2f> base_pts = {
+            {15.0F, 15.0F}, {45.0F, 20.0F}, {90.0F, 18.0F}, {130.0F, 25.0F}, {25.0F, 60.0F},
+            {75.0F, 55.0F}, {120.0F, 65.0F}, {20.0F, 105.0F}, {80.0F, 100.0F}, {135.0F, 110.0F},
+        };
+        SigfmPtr ref = make_synthetic_features(base_pts);
+
+        // Exact similarity transforms at the inclusive gate bounds. All 10
+        // descriptor pairs are identical (ratio 0), so the model fit is exact
+        // and the inlier count is deterministic for any RNG seed.
+        SigfmPtr s080 = make_synthetic_features(transform_pts(base_pts, 0.80, 10.0, 5.0F, -3.0F));
+        SigfmPtr s125 = make_synthetic_features(transform_pts(base_pts, 1.25, -10.0, -5.0F, 3.0F));
+
+        cv::setRNGSeed(42);
+        CHECK(sigfm_match_score(ref.get(), s080.get()) == 10);
+        cv::setRNGSeed(42);
+        CHECK(sigfm_match_score(ref.get(), s125.get()) == 10);
+    }
+
+    TEST_CASE("reciprocal matching rejects many-to-one ratio candidates")
+    {
+        const std::vector<cv::Point2f> probe_pts = {
+            {10.0F, 10.0F}, {50.0F, 15.0F}, {90.0F, 20.0F},
+            {20.0F, 70.0F}, {80.0F, 75.0F},
+            {5.0F, 5.0F}, {15.0F, 5.0F}, {25.0F, 5.0F}, {35.0F, 5.0F},
+            {45.0F, 5.0F}, {55.0F, 5.0F}, {65.0F, 5.0F}, {75.0F, 5.0F},
+        };
+        const std::vector<cv::Point2f> enrolled_pts = {
+            {17.0F, 5.0F}, {57.0F, 10.0F}, {97.0F, 15.0F},
+            {27.0F, 65.0F}, {87.0F, 70.0F}, {140.0F, 100.0F},
+        };
+        SigfmPtr probe = make_synthetic_features(probe_pts);
+        SigfmPtr enrolled = make_synthetic_features(enrolled_pts);
+        probe->descriptors.setTo(cv::Scalar(0));
+        enrolled->descriptors.setTo(cv::Scalar(0));
+
+        // Five unambiguous one-to-one correspondences.
+        for (int i = 0; i < 5; ++i) {
+            probe->descriptors.at<float>(i, i) = 1.0F;
+            enrolled->descriptors.at<float>(i, i) = 1.0F;
+        }
+
+        // Eight additional probe rows pass the forward ratio test against the
+        // same enrolled row. Only the closest one survives the reverse 1-NN.
+        enrolled->descriptors.at<float>(5, 20) = 1.0F;
+        for (int i = 0; i < 8; ++i) {
+            probe->descriptors.at<float>(5 + i, 20) = 1.0F;
+            probe->descriptors.at<float>(5 + i, 30 + i) = 0.01F * (i + 1);
+        }
+
+        // Without reciprocal filtering all 12 ratio-passing candidates reach
+        // RANSAC. Max-inlier selection prefers the 8-way degenerate consensus
+        // (every junk match maps onto the single enrolled point {140,100})
+        // over the 5-point genuine similarity, and the resulting near-zero
+        // scale of that degenerate model is rejected by the 0.80 scale gate,
+        // so the score is 0. This outcome relies on RANSAC preferring the
+        // largest consensus; the reciprocal default below is the primary
+        // assertion because it is deterministic by construction: only the 5
+        // mutual-NN pairs survive and score exactly 5.
+        cv::setRNGSeed(42);
+        CHECK(sigfm_match_score_with_flags(
+                  probe.get(), enrolled.get(), SIGFM_MATCH_FLAG_FORWARD_ONLY) == 0);
+        cv::setRNGSeed(42);
+        CHECK(sigfm_match_score(probe.get(), enrolled.get()) == 5);
+    }
+
+    TEST_CASE("frame coverage tiles and contrast boundary")
+    {
+        CHECK(sigfm_image_coverage(nullptr, 80, 64) == 0.0);
+        cv::Mat too_small(4, 4, CV_8UC1, cv::Scalar(128));
+        CHECK(sigfm_image_coverage(too_small.data, 4, 4) == 0.0);
+
+        cv::Mat blank(64, 80, CV_8UC1, cv::Scalar(128));
+        CHECK(sigfm_image_coverage(blank.data, 80, 64) == 0.0);
+
+        cv::Mat textured(64, 80, CV_8UC1);
+        for (int y = 0; y < textured.rows; ++y) {
+            for (int x = 0; x < textured.cols; ++x) {
+                textured.at<unsigned char>(y, x) = ((x + y) & 1) ? 50 : 0;
+            }
+        }
+        // Exactly 25 grey levels of standard deviation is active (>= gate).
+        CHECK(sigfm_image_coverage(textured.data, 80, 64) == doctest::Approx(1.0));
+
+        blank.setTo(cv::Scalar(128));
+        for (int y = 2; y < 10; ++y) {
+            for (int x = 2; x < 10; ++x) {
+                blank.at<unsigned char>(y, x) = ((x + y) & 1) ? 255 : 0;
+            }
+        }
+        // 9 columns * 7 rows of complete 8x8 tiles inside the 2 px border.
+        CHECK(sigfm_image_coverage(blank.data, 80, 64) == doctest::Approx(1.0 / 63.0));
+    }
+
+    TEST_CASE("coverage counts the last full tile and ignores trailing partial area")
+    {
+        // 80x64 with a 2 px border leaves tiles at x in {2..66}, y in {2..50}:
+        // 9 columns * 7 rows = 63 complete 8x8 tiles.
+        // Texture only inside the last complete tile (origin 66,50).
+        cv::Mat last(64, 80, CV_8UC1, cv::Scalar(128));
+        for (int y = 50; y < 58; ++y) {
+            for (int x = 66; x < 74; ++x) {
+                last.at<unsigned char>(y, x) = ((x + y) & 1) ? 255 : 0;
+            }
+        }
+        CHECK(sigfm_image_coverage(last.data, 80, 64) == doctest::Approx(1.0 / 63.0));
+
+        // The same contrast straddling the right edge (x 74..79) lies outside
+        // every complete tile, so it must not register as coverage.
+        cv::Mat trailing(64, 80, CV_8UC1, cv::Scalar(128));
+        for (int y = 2; y < 10; ++y) {
+            for (int x = 74; x < 80; ++x) {
+                trailing.at<unsigned char>(y, x) = ((x + y) & 1) ? 255 : 0;
+            }
+        }
+        CHECK(sigfm_image_coverage(trailing.data, 80, 64) == 0.0);
+    }
+
+    TEST_CASE("translation consensus is an opt-in A/B variant")
+    {
+        const std::vector<cv::Point2f> pts = {
+            {15.0F, 15.0F}, {45.0F, 20.0F}, {90.0F, 18.0F}, {130.0F, 25.0F},
+            {25.0F, 60.0F}, {75.0F, 55.0F}, {120.0F, 65.0F}, {20.0F, 105.0F},
+            {80.0F, 100.0F}, {135.0F, 110.0F},
+        };
+        std::vector<cv::Point2f> transformed;
+        for (const auto &p : pts) {
+            transformed.emplace_back(1.1F * p.x + 7.0F, 1.1F * p.y - 5.0F);
+        }
+        SigfmPtr probe = make_synthetic_features(pts);
+        SigfmPtr enrolled = make_synthetic_features(transformed);
+
+        cv::setRNGSeed(42);
+        CHECK(sigfm_match_score(probe.get(), enrolled.get()) == 10);
+        cv::setRNGSeed(42);
+        CHECK(sigfm_match_score_with_flags(
+                  probe.get(), enrolled.get(), SIGFM_MATCH_FLAG_TRANSLATION_CONSENSUS) == 10);
+        CHECK(sigfm_match_score_with_flags(probe.get(), enrolled.get(), 0x80000000U) < 0);
+    }
+}

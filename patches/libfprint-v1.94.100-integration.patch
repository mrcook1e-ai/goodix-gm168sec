+/**
+ * fpi_print_sigfm_match:
+ * @print_template: A #FpPrint containing one or more prints
+ * @print: A newly scanned #FpPrint to test
+ * @sigfm_threshold: The SIGFM match threshold
+ * @error: Return location for error
+ *
+ * Match the newly scanned @print (containing exactly one print) against the
+ * prints contained in @print_template which will have been stored during enrollment.
+ *
+ * Both @print_template and @print need to be of type #FPI_PRINT_SIGFM for this to
+ * work.
+ *
+ * Returns: Whether the prints match, @error will be set if #FPI_MATCH_ERROR is returned
+ */
+FpiMatchResult
+fpi_print_sigfm_match (FpPrint *print_template,
+                       FpPrint *print,
+                       gint     sigfm_threshold,
+                       GError **error)
+{
+#if defined(HAVE_SIGFM) && HAVE_SIGFM
+  SigfmImgInfo *probe;
+  guint i;
+
+  if (print_template->type != FPI_PRINT_SIGFM || print->type != FPI_PRINT_SIGFM)
+    {
+      g_set_error (error,
+                   FP_DEVICE_ERROR,
+                   FP_DEVICE_ERROR_NOT_SUPPORTED,
+                   "It is only possible to match SIGFM type print data");
+      return FPI_MATCH_ERROR;
+    }
+
+  if (!print->prints || print->prints->len != 1)
+    {
+      g_set_error (error,
+                   FP_DEVICE_ERROR,
+                   FP_DEVICE_ERROR_GENERAL,
+                   "New print does not contain exactly one print!");
+      return FPI_MATCH_ERROR;
+    }
+
+  if (!print_template->prints || print_template->prints->len == 0)
+    {
+      g_set_error (error,
+                   FP_DEVICE_ERROR,
+                   FP_DEVICE_ERROR_DATA_INVALID,
+                   "Template print contains no SIGFM entries!");
+      return FPI_MATCH_ERROR;
+    }
+
+  probe = g_ptr_array_index (print->prints, 0);
+
+  for (i = 0; i < print_template->prints->len; i++)
+    {
+      SigfmImgInfo *enrolled = g_ptr_array_index (print_template->prints, i);
+      gint score = sigfm_match_score (probe, enrolled);
+
+      if (score < 0)
+        {
+          g_set_error (error,
+                       FP_DEVICE_ERROR,
+                       FP_DEVICE_ERROR_DATA_INVALID,
+                       "SIGFM matching failed with error %d", score);
+          return FPI_MATCH_ERROR;
+        }
+
+      fp_dbg ("sigfm score %d/%d", score, sigfm_threshold);
+
+      if (score >= sigfm_threshold)
+        return FPI_MATCH_SUCCESS;
+    }
+
+  return FPI_MATCH_FAIL;
+#else
+  g_set_error (error,
+               FP_DEVICE_ERROR,
+               FP_DEVICE_ERROR_NOT_SUPPORTED,
+               "SIGFM support is not compiled in!");
+  return FPI_MATCH_ERROR;
+#endif
+}
+
+/**
+ * fpi_print_sigfm_max_score:
+ * @print_template: A #FpPrint containing zero or more SIGFM entries
+ * @print: A newly scanned #FpPrint containing one SIGFM entry
+ * @max_score: (out): Return location for the maximum SIGFM score
+ * @error: Return location for error
+ *
+ * Computes the maximum SIGFM match score of @print against all entries in
+ * @print_template. Intended for enrollment overlap / duplicate detection.
+ *
+ * Returns: %TRUE on success, %FALSE with @error set on error
+ */
+gboolean
+fpi_print_sigfm_max_score (FpPrint *print_template,
+                           FpPrint *print,
+                           gint    *max_score,
+                           GError **error)
+{
+#if defined(HAVE_SIGFM) && HAVE_SIGFM
+  SigfmImgInfo *probe;
+  gint best = 0;
+  guint i;
+
+  g_return_val_if_fail (max_score != NULL, FALSE);
+  *max_score = 0;
+
+  if (print_template->type != FPI_PRINT_SIGFM || print->type != FPI_PRINT_SIGFM)
+    {
+      g_set_error (error,
+                   FP_DEVICE_ERROR,
+                   FP_DEVICE_ERROR_NOT_SUPPORTED,
+                   "It is only possible to score SIGFM type print data");
+      return FALSE;
+    }
+
+  if (!print->prints || print->prints->len != 1)
+    {
+      g_set_error (error,
+                   FP_DEVICE_ERROR,
+                   FP_DEVICE_ERROR_GENERAL,
+                   "New print does not contain exactly one print!");
+      return FALSE;
+    }
+
+  if (!print_template->prints || print_template->prints->len == 0)
+    return TRUE;
+
+  probe = g_ptr_array_index (print->prints, 0);
+
+  for (i = 0; i < print_template->prints->len; i++)
+    {
+      SigfmImgInfo *enrolled = g_ptr_array_index (print_template->prints, i);
+      gint score = sigfm_match_score (probe, enrolled);
+
+      if (score < 0)
+        {
+          g_set_error (error,
+                       FP_DEVICE_ERROR,
+                       FP_DEVICE_ERROR_DATA_INVALID,
+                       "SIGFM matching failed with error %d", score);
+          return FALSE;
+        }
+
+      if (score > best)
+        best = score;
+    }
+
+  *max_score = best;
+  return TRUE;
+#else
+  if (max_score)
+    *max_score = 0;
+  g_set_error (error,
+               FP_DEVICE_ERROR,
+               FP_DEVICE_ERROR_NOT_SUPPORTED,
+               "SIGFM support is not compiled in!");
+  return FALSE;
+#endif
+}

# Force LF on Linux-target files regardless of editor/OS settings.
*.sh     text eol=lf
*.py     text eol=lf
*.c      text eol=lf
*.h      text eol=lf
*.cpp    text eol=lf
*.hpp    text eol=lf
*.md     text eol=lf
*.svg    text eol=lf
*.png    binary
# Patch context must preserve upstream whitespace for git apply.
*.patch  text eol=lf whitespace=-trailing-space
*.rules  text eol=lf
*.spec   text eol=lf
*.yml    text eol=lf

# Build files
meson.build   text eol=lf
meson.options text eol=lf
